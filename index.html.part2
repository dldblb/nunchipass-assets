const DATA=JSON.parse(document.getElementById('content-data').textContent);
const CATS=[{id:'etiquette',name:'경조사·인간관계',icon:'gift',desc:'결혼식부터 장례식까지, 알아두면 도움이 되는 사회생활 예절'},{id:'finance',name:'돈 관리·금융생활',icon:'wallet',desc:'월급 관리부터 대출과 보험까지, 알아두면 도움이 되는 금융 상식'},{id:'housing',name:'자취·주거생활',icon:'home',desc:'처음 독립하는 청년을 위한 집 계약, 이사, 살림 관리'},{id:'work',name:'직장·사회생활',icon:'briefcase',desc:'첫 출근부터 이직과 퇴사까지, 사회초년생의 직장생활 지침서'},{id:'admin',name:'생활행정·문제해결',icon:'clipboard',desc:'각종 행정 업무와 일상에서 발생하는 문제를 해결하는 방법'}];
const paths={search:'<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>',sun:'<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/>',moon:'<path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"/>',gift:'<path d="M3 9h18v4H3zm2 4v8h14v-8M12 9v12"/><path d="M12 9C5 9 5 2 8 3c3 0 4 6 4 6Zm0 0c7 0 7-7 4-6-3 0-4 6-4 6Z"/>',wallet:'<path d="M20 7H5a2 2 0 0 1 0-4h13v4M3 5v14a2 2 0 0 0 2 2h15V7m0 5h-6v5h6"/><circle cx="16" cy="14.5" r=".5"/>',home:'<path d="m3 10 9-7 9 7M5 9v12h14V9m-10 12v-8h6v8"/>',briefcase:'<rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V3h8v4M3 12c6 4 12 4 18 0m-9 1v4"/>',clipboard:'<rect x="5" y="4" width="14" height="18" rx="2"/><rect x="9" y="2" width="6" height="4" rx="1"/><path d="M9 11h6m-6 4h6m-6 4h4"/>',bookmark:'<path d="M6 3h12v19l-6-4-6 4Z"/>',arrow:'<path d="M4 12h16m-6-6 6 6-6 6"/>',grid:'<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',share:'<path d="M12 16V3m-5 5 5-5 5 5M5 12v9h14v-9"/>',check:'<path d="m5 12 4 4L19 6"/>'};
const icon=n=>`<svg viewBox="0 0 24 24" aria-hidden="true">${paths[n]||paths.grid}</svg>`;
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const safeURL=s=>{try{const u=new URL(s);return ['https:','http:'].includes(u.protocol)?esc(u.href):'#'}catch{return '#'}};
function readStorage(k,fallback){try{return JSON.parse(localStorage.getItem(k))??fallback}catch{return fallback}}
const savedBookmarks=readStorage('life-bookmarks',[]);let bookmarks=new Set((Array.isArray(savedBookmarks)?savedBookmarks:[]).filter(id=>DATA.some(t=>t.id===id&&!t.archived&&String(t.core||'').trim())));let theme=readStorage('life-theme',null);let storageWarning=false;
function save(k,v){try{localStorage.setItem(k,JSON.stringify(v));return true}catch{if(!storageWarning){toast('이 브라우저에서는 저장할 수 없어요. 현재 화면에서는 사용할 수 있습니다.');storageWarning=true}return false}}
function applyTheme(){document.body.classList.toggle('dark',theme==='dark'||(!theme&&matchMedia('(prefers-color-scheme: dark)').matches));const dark=document.body.classList.contains('dark');document.getElementById('theme').innerHTML=icon(dark?'sun':'moon');document.getElementById('theme').setAttribute('aria-label',dark?'라이트모드로 전환':'다크모드로 전환');document.getElementById('theme').setAttribute('aria-pressed',String(dark))}
applyTheme();matchMedia('(prefers-color-scheme: dark)').addEventListener?.('change',()=>{if(!theme)applyTheme()});
document.getElementById('theme').onclick=()=>{theme=document.body.classList.contains('dark')?'light':'dark';save('life-theme',theme);applyTheme()};
document.getElementById('search-focus').innerHTML=icon('search');document.getElementById('search-focus').onclick=()=>window.npOpenSearch();
let toastTimer;function toast(msg){const el=document.getElementById('toast');el.textContent=msg;el.style.display='block';clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.style.display='none',3200)}
const cat=id=>CATS.find(c=>c.id===id);const textOf=t=>[t.title,t.summary,t.core,t.major,t.minor,...t.tags,...t.basics,...t.examples,...t.steps,...t.cautions,...t.extra,...t.keywords,...(Array.isArray(t.sections)?t.sections.map(s=>s.text||''):[])].filter(Boolean).join(' ');
DATA.forEach(t=>{t.searchText=textOf(t).toLowerCase();t.minutes=Math.max(1,Math.ceil(textOf(t).replace(/\s/g,'').length/500))});
const chosung=s=>Array.from(s).map(c=>{const n=c.charCodeAt(0)-44032;return n>=0&&n<=11171?'ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ'[Math.floor(n/588)]:c}).join('');
function match(t,q){const tokens=q.trim().toLowerCase().split(/\s+/).filter(Boolean);return tokens.every(w=>/^[ㄱ-ㅎ]+$/.test(w)?chosung(t.searchText).includes(w):t.searchText.includes(w))}
function highlight(s,q){if(!q.trim())return esc(s);const tokens=q.trim().split(/\s+/).filter(x=>! /^[ㄱ-ㅎ]+$/.test(x));if(!tokens.length)return esc(s);const rx=new RegExp('('+tokens.map(x=>x.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')).join('|')+')','gi');return String(s).split(rx).map((p,i)=>i%2?`<mark>${esc(p)}</mark>`:esc(p)).join('')}
const recommended=DATA.filter(t=>!t.archived&&String(t.core||'').trim()).slice(0,6).map(t=>t.id);

const viewLog=readStorage('nunchipass-local-views-v1',[]);
const cleanViews=Array.isArray(viewLog)?viewLog.filter(x=>x&&typeof x.id==='string'&&Number.isFinite(x.ts)&&x.ts>Date.now()-1000*86400*730):[];
let lastCountedRoute='';
function recordView(id){const key=id+'|'+location.hash;if(lastCountedRoute===key)return;lastCountedRoute=key;cleanViews.push({id,ts:Date.now()});save('nunchipass-local-views-v1',cleanViews)}
function topRanking(period){const cutoff=period==='7'?Date.now()-7*86400000:period==='30'?Date.now()-30*86400000:0;const tally=new Map();for(const hit of cleanViews){if(hit.ts>=cutoff)tally.set(hit.id,(tally.get(hit.id)||0)+1)}return [...tally].map(([id,count])=>({t:DATA.find(x=>x.id===id&&!x.archived),count})).filter(x=>x.t).sort((a,b)=>b.count-a.count||a.t.title.localeCompare(b.t.title,'ko')).slice(0,10)}
function exampleRanking(period,real){
  const chosen=new Set(real.map(x=>x.t.id));
  const candidates=DATA.filter(t=>!t.archived&&t.core&&!chosen.has(t.id));
  const keywordGroups=period==='7'?['회식','결혼식','이사','전입신고','축의금','근로계약','월세','개인정보','첫 출근','명절']:period==='30'?['전입신고','계약','하객','술자리','연차','보증금','퇴사','세금','축의금','이사']:['축의금','결혼식','근로계약','월세','이사','회식','전입신고','청첩장','연말정산','예절'];
  const picked=[];
  for(const key of keywordGroups){const i=candidates.findIndex(t=>!picked.some(x=>x.id===t.id)&&(t.title||'').includes(key));if(i>=0)picked.push(candidates[i]);if(picked.length>=10-real.length)break}
  for(const t of candidates){if(picked.length>=10-real.length)break;if(!picked.some(x=>x.id===t.id))picked.push(t)}
  return [...real.map(x=>({...x,example:false})),...picked.slice(0,10-real.length).map(t=>({t,count:0,example:true}))];
}
function topPage(){const period=['7','30','all'].includes(route.period)?route.period:'7';const actual=topRanking(period);const list=exampleRanking(period,actual);return `<div class="page-end"><div class="page-top"><div class="eyebrow">Reading chart</div><h1>생활 팁 TOP 10</h1><p>실제 열람 기록이 쌓이기 전까지 기존 데이터베이스의 생활 팁을 예시로 함께 표시합니다.</p></div><div class="period-tabs"><a class="${period==='7'?'active':''}" href="#top10/7">최근 7일</a><a class="${period==='30'?'active':''}" href="#top10/30">최근 30일</a><a class="${period==='all'?'active':''}" href="#top10/all">전체 기간</a></div><div class="top-notice">‘예시’가 표시된 항목은 실제 인기 순위가 아니라 임시로 배치한 콘텐츠입니다. 열람 횟수는 이 브라우저에서만 기록되며, 다른 사용자 기록은 반영되지 않습니다.${actual.length?' 실제 열람 기록이 있는 항목을 먼저 표시합니다.':''}</div><div class="ranking-list">${list.map(({t,count,example},i)=>`<a class="rank-item" href="#tip/${t.id}"><b class="rank-num">${i+1}</b><div class="rank-content"><span class="badge">${cat(t.cat).name}</span><h2>${esc(t.title)}</h2><p>${esc(t.summary)}</p></div><span class="rank-count ${example?'example':''}">${example?'예시':count+'회 열람'}</span></a>`).join('')}</div></div>`}

const SEASONS=[
{id:'newyear',name:'설날·명절',period:'1~2월',months:[1,2],words:['명절','설날','세배','새해 인사','친척','가족 모임','선물 예절']},
{id:'moving',name:'봄·가을 이사철',period:'2~3월 · 8~9월',months:[2,3,8,9],words:['이사','전입신고','월세','보증금','임대차','계약']},
{id:'job',name:'취업·입사철',period:'2~4월',months:[2,3,4],words:['첫 출근','신입','입사','근로계약','직장 예절','연차']},
{id:'wedding',name:'결혼식 성수기',period:'4~6월 · 9~11월',months:[4,5,6,9,10,11],words:['결혼식','축의금','하객','청첩장']},
{id:'summer',name:'여름휴가',period:'6~8월',months:[6,7,8],words:['휴가','여행','연차','휴가 신청']},
{id:'chuseok',name:'추석·명절',period:'9~10월',months:[9,10],words:['추석','명절','선물','인사','가족 모임']},
{id:'yearend',name:'연말연시',period:'11~1월',months:[11,12,1],words:['송년회','회식','술자리','연말정산','새해','세금']}];
function seasonMatches(season){return DATA.filter(t=>!t.archived&&t.core).map(t=>{const title=(t.title||'').toLowerCase(), corpus=[t.summary||'',...(t.keywords||[])].join(' ').toLowerCase();let score=0;for(const word of season.words){const w=word.toLowerCase();if(title.includes(w))score+=4;else if(corpus.includes(w))score+=1}return {t,score}}).filter(x=>x.score>0).sort((a,b)=>b.score-a.score||a.t.title.localeCompare(b.t.title,'ko')).slice(0,5).map(x=>x.t)}
function seasonPage(){const month=+(new Intl.DateTimeFormat('en-US',{timeZone:'Asia/Seoul',month:'numeric'}).format(new Date()));const active=SEASONS.filter(x=>x.months.includes(month));const rest=SEASONS.filter(x=>!x.months.includes(month));const build=(arr)=>arr.map(season=>{const matches=seasonMatches(season);return matches.length?`<section class="season-section" id="season-${season.id}"><div class="section-head"><div><div class="season-title-row"><h2>${season.name}</h2><span class="season-period">${season.period}</span></div><p>기존 데이터베이스의 관련 생활 팁 ${matches.length}개</p></div></div><div class="cards">${matches.map(t=>card(t)).join('')}</div></section>`:''}).join('');return `<div class="page-end"><div class="page-top"><div class="eyebrow">Seasonal guide</div><h1>시즌별 생활 팁</h1><p>한국 시간 기준 현재 월에 해당하는 시기를 먼저 보여줍니다. 추천 콘텐츠는 기존 데이터베이스에서만 선택합니다.</p></div><div class="season-label">지금 살펴볼 생활 팁</div>${build(active)||'<p class="season-empty">현재 시기에 해당하는 콘텐츠가 없습니다.</p>'}<div class="season-label season-other">다른 시즌의 생활 팁</div>${build(rest)||'<p class="season-empty">다른 시즌에 해당하는 콘텐츠가 없습니다.</p>'}</div>`}

function bookButton(t){const on=bookmarks.has(t.id);return `<button class="bookmark" data-book="${t.id}" aria-label="${esc(t.title)} 즐겨찾기 ${on?'해제':'저장'}" aria-pressed="${on}">${icon('bookmark')}</button>`}
function card(t,q=''){return `<article class="card"><div class="top"><span class="badge">${cat(t.cat).name}</span>${bookButton(t)}</div><h3><a href="#tip/${t.id}">${highlight(t.title,q)}</a></h3><p>${highlight(t.summary,q)}</p><div class="meta"><span>약 ${t.minutes}분 읽기 · ${esc(t.kind||t.status||'작성 준비 중')}</span><span>${icon('arrow')}</span></div></article>`}
function catCards(){return `<div class="categories">${CATS.map((c,i)=>`<a class="category" href="#tips?cat=${c.id}"><div class="cat-icon" style="${i===1?'color:#388064;background:color-mix(in srgb,#388064 12%,var(--paper))':i===2?'color:#bc7440;background:color-mix(in srgb,#bc7440 12%,var(--paper))':i===3?'color:#8260ac;background:color-mix(in srgb,#8260ac 12%,var(--paper))':i===4?'color:#44818f;background:color-mix(in srgb,#44818f 12%,var(--paper))':''}">${icon(c.icon)}</div><h3>${c.name}</h3><p>${c.desc}</p><div class="cat-bottom"><span><b>${DATA.filter(t=>!t.archived&&t.cat===c.id).length}</b>가지 생활 팁</span><span>자세히 보기 ↗</span></div></a>`).join('')}</div>`}
function searchForm(q=''){return `<form class="search" id="search-form" role="search">${icon('search')}<input id="query" name="q" type="search" autocomplete="off" aria-label="생활정보 제목, 본문, 키워드 검색" placeholder="축의금, 월세 계약, 연차휴가, 이사 준비..." value="${esc(q)}"><button type="submit">검색</button></form>`}
function dailyTip(){const day=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Seoul',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());const parts=day.match(/\d+/g);const date=parts[0].length===4?parts:[parts[2],parts[0],parts[1]];return {t:DATA.filter(t=>!t.archived&&t.core)[Math.floor(Date.UTC(+date[0],+date[1]-1,+date[2])/86400000)%DATA.filter(t=>!t.archived&&t.core).length],day:date.join('.')}}
const NP_SCENE_SVGS={"wedding":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1536 1024\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" aria-label=\"눈치패스 캐릭터 삽화\"><image width=\"1536\" height=\"1024\" href=\"https://dldblb.github.io/nunchipass-assets/images/asset_135.webp\"/></svg>","funeral":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1536 1024\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" aria-label=\"눈치패스 캐릭터 삽화\"><image width=\"1536\" height=\"1024\" href=\"https://dldblb.github.io/nunchipass-assets/images/asset_136.webp\"/></svg>","housing":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1536 1024\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" aria-label=\"눈치패스 캐릭터 삽화\"><image width=\"1536\" height=\"1024\" href=\"https://dldblb.github.io/nunchipass-assets/images/asset_137.webp\"/></svg>","resign":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1448 1086\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" aria-label=\"눈치패스 캐릭터 삽화\"><image width=\"1448\" height=\"1086\" href=\"https://dldblb.github.io/nunchipass-assets/images/asset_138.png\"/></svg>"};
function home(){const d=dailyTip();const count=DATA.filter(t=>!t.archived&&String(t.core||'').trim()).length;const scene=[
['wedding','결혼식 초대받았을 때','축의금 · 하객 예절','축의금'],
['funeral','부고를 받았을 때','조문 · 위로 인사','장례식'],
['housing','처음 집을 구할 때','계약 · 보증금','월세'],
['resign','퇴사를 준비할 때','절차 · 서류','퇴사']
];return `<div class="np-home"><section class="hero"><div class="hero-layout"><div class="hero-copy"><div class="eyebrow">OFFLINE LIFE HANDBOOK</div><p class="hero-subtitle">어른이 처음인 당신에게,</p><h1><span>눈치패스</span></h1><p class="hero-tagline">학교에서는 알려주지 않았던 생활의 모든 것</p><p class="hero-description">축의금, 월세 계약, 첫 출근까지.<br>처음 겪는 상황에서 필요한 답을 빠르게 찾아보세요.</p><div class="np-search-area">${searchForm()}<div class="np-art np-hero-mascot" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1254 1254" preserveAspectRatio="xMidYMid meet" role="img" aria-label="눈치패스 캐릭터 삽화"><image width="1254" height="1254" href="https://dldblb.github.io/nunchipass-assets/images/asset_139.webp"/></svg></div></div><div class="mobile-hint">검색어를 입력하면 ${count}가지 생활 팁에서 찾아드려요.</div><div class="tags">${['축의금','장례식예절','월세계약','퇴사준비','사회초년생'].map(x=>`<button class="tag" data-tag="${x}">#${x}</button>`).join('')}</div></div><aside class="hero-note"><div class="issue"><span>THE LIFE HANDBOOK</span><span>VOL. 01</span></div><div class="np-note-copy"><h2>처음인 당신을 위한<br>생활의 작은 기준들.</h2><p>사회생활부터 돈 관리까지,<br>필요한 순간에 펼쳐보는 <br class="np-card-mobile-break">생활 지침서.</p><div class="note-bottom">${icon('check')} <span>생활백과, <br class="np-card-mobile-break">핵심 답변부터.</span></div><a class="np-start-button" href="#tips">처음이라면, 여기부터 <span aria-hidden="true">→</span></a></div><div class="np-art np-cover-art" aria-hidden="true"><img src="https://dldblb.github.io/nunchipass-assets/images/asset_140.webp" alt="즐겁게 웃는 미어캣과 펭귄" decoding="async"></div></aside></div></section><section class="section daily-feature"><div class="daily${TIP_IMAGES[d.t.id]?' daily-has-illustration':''}"><div class="daily-label"><div class="eyebrow">ONE TIP A DAY</div><h2>오늘의 생활 팁</h2><p>${d.day} · 한국 시간 기준</p></div><div class="daily-content"><h3>${esc(d.t.title)}</h3><p>${esc(d.t.summary)}</p></div>${TIP_IMAGES[d.t.id]?`<div class="np-today-illustration"><img src="${TIP_IMAGES[d.t.id]}" alt="${esc(d.t.title)} 관련 그림" decoding="async"></div>`:''}<a class="icon-btn" href="#tip/${d.t.id}" aria-label="오늘의 생활 팁 읽기">${icon('arrow')}</a></div></section><section class="situation"><div class="section-head situation-head"><div><h2>이런 상황, 어떻게 하지?</h2><p>고민되는 순간을 바로 선택해보세요.</p></div></div><div class="situations">${scene.map(([key,title,sub,q])=>`<a class="situation-link" href="#tips?q=${encodeURIComponent(q)}"><div class="np-scene-image np-scene-${key}">${NP_SCENE_SVGS[key]||""}</div><span class="situation-caption"><strong>${title}</strong><small>${sub}</small></span></a>`).join('')}</div></section><section class="home-share" aria-labelledby="home-share-title"><div class="home-share-copy"><div class="eyebrow">SHARE NUNCHIPASS</div><h2 id="home-share-title">친구에게도 눈치패스를 알려주세요</h2><p>처음 겪는 상황에서 필요한 생활 팁을 함께 나눠보세요.</p></div><div class="np-art np-share-art" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1536 1024" preserveAspectRatio="xMidYMid meet" role="img" aria-label="눈치패스 캐릭터 삽화"><image width="1536" height="1024" href="https://dldblb.github.io/nunchipass-assets/images/asset_141.webp"/></svg></div><button type="button" class="home-share-button" data-share-site aria-label="눈치패스 웹사이트 공유하기">${icon('arrow')} <span>눈치패스 추천하기</span></button></section></div>`}
let route={},lastList='#tips';let sortMode='default',layer='',subgroup='';
function parseRoute(){const hash=location.hash.slice(1)||'home';const [path,qs]=hash.split('?');const params=new URLSearchParams(qs);return {view:path.startsWith('tip/')?'detail':path.startsWith('top10/')?'top10':path,id:path.startsWith('tip/')?path.slice(4):null,period:path.startsWith('top10/')?path.slice(6):'7',q:params.get('q')||'',cat:CATS.some(c=>c.id===params.get('cat'))?params.get('cat'):'all'}}
function routeURL(view,q,category){const p=new URLSearchParams();if(q)p.set('q',q);if(category!=='all')p.set('cat',category);return '#'+view+(p.size?'?'+p.toString():'')}
function selectedItems(){let list=DATA.filter(t=>t.archived===(route.view==='archive')&&(route.view==='archive'||String(t.core||'').trim())&&(!layer||t.major===layer)&&(!subgroup||t.minor===subgroup)&&(route.cat==='all'||t.cat===route.cat)&&match(t,route.q));if(route.view==='saved')list=list.filter(t=>bookmarks.has(t.id));if(route.view==='popular')list=list.filter(t=>recommended.includes(t.id)).sort((a,b)=>recommended.indexOf(a.id)-recommended.indexOf(b.id));if(sortMode==='title')list.sort((a,b)=>a.title.localeCompare(b.title,'ko'));if(sortMode==='short')list.sort((a,b)=>a.minutes-b.minutes);return list}
function filters(){return [{id:'all',name:'전체'},...CATS].map(c=>{let n=DATA.filter(t=>t.archived===(route.view==='archive')&&(route.view==='archive'||String(t.core||'').trim())&&(!layer||t.major===layer)&&(!subgroup||t.minor===subgroup)&&(c.id==='all'||t.cat===c.id)&&match(t,route.q)&&(route.view!=='saved'||bookmarks.has(t.id))&&(route.view!=='popular'||recommended.includes(t.id))).length;return `<button class="filter ${route.cat===c.id?'active':''}" data-filter="${c.id}" aria-pressed="${route.cat===c.id}">${c.name} ${n}</button>`}).join('')}
function results(){const list=selectedItems();return `<div class="results-bar"><span role="status" aria-live="polite">${route.q?`‘${esc(route.q)}’ 검색 · `:''}<b>${list.length}</b>개의 생활 팁</span><label>정렬 <select id="sort"><option value="default" ${sortMode==='default'?'selected':''}>${route.view==='popular'?'추천순':'기본순'}</option><option value="title" ${sortMode==='title'?'selected':''}>제목순</option><option value="short" ${sortMode==='short'?'selected':''}>짧은 글부터</option></select></label></div><div class="cards">${list.length?list.map(t=>card(t,route.q)).join(''):`<div class="empty">${icon(route.view==='saved'?'bookmark':'search')}<h2>${route.view==='saved'?'저장한 생활 팁이 없어요.':'일치하는 생활 팁을 찾지 못했어요.'}</h2><p>${route.view==='saved'?'마음에 드는 글의 북마크 버튼을 눌러 모아보세요.':'검색어를 짧게 바꾸거나 다른 카테고리를 선택해 보세요.'}</p><a href="#tips" class="primary">전체 생활 팁 보기</a></div>`}</div>`}
function listPage(){const title=route.view==='archive'?'통합·제외 콘텐츠':route.view==='saved'?'나만의 생활 지침서':route.view==='popular'?'추천 생활 팁':route.cat!=='all'?cat(route.cat).name:'전체 생활 팁';const desc=route.view==='saved'?'필요한 순간 다시 꺼내보세요. 즐겨찾기는 이 브라우저에 저장됩니다.':route.view==='popular'?'실제 조회수 대신 편집부가 지정한 추천 순서로 소개합니다.':'제목, 본문, 키워드를 검색하고 카테고리로 좁혀보세요. 초성 검색도 가능합니다.';return `<div class="page-end"><div class="page-top"><div class="eyebrow">Find your answer</div><h1>${title}</h1><p>${desc}</p></div><div class="list-controls">${searchForm(route.q)}<div class="filter-row" id="filters">${filters()}</div></div><div class="filter-row"><label>대분류 <select id="layer"><option value="">전체</option>${[...new Set(DATA.map(t=>t.major).filter(Boolean))].map(v=>`<option ${layer===v?'selected':''}>${esc(v)}</option>`).join('')}</select></label><label>소분류 <select id="subgroup"><option value="">전체</option>${[...new Set(DATA.map(t=>t.minor).filter(Boolean))].map(v=>`<option ${subgroup===v?'selected':''}>${esc(v)}</option>`).join('')}</select></label><a class="text-link" href="${route.view==='archive'?'#tips':'#archive'}">${route.view==='archive'?'일반 목록 보기':'통합·제외 콘텐츠 보기'}</a></div><div id="results">${results()}</div></div>`}
function section(t,key,title,num,ordered=false){const items=t[key]||[];return `<section class="article-section" id="${key}"><h2><span class="section-number">${num}</span>${title}</h2>${items.length?`<${ordered?'ol':'ul'}>${items.map(x=>`<li>${esc(x)}</li>`).join('')}</${ordered?'ol':'ul'}>`:'<p class="source-note">이 항목은 확인된 핵심 답변과 아래 출처를 우선 참고하세요.</p>'}</section>`}
function related(t){return DATA.filter(x=>!x.archived&&x.cat===t.cat&&x.id!==t.id).map(x=>({t:x,score:x.keywords.filter(k=>t.keywords.includes(k)).length})).sort((a,b)=>b.score-a.score).slice(0,3).map(x=>x.t)}
// 상세 콘텐츠 공통 표기: 원본 텍스트와 데이터는 유지하고 화면에 표시하는 소제목만 통일합니다.
function sectionDisplayTitle(title){
  const raw=String(title||'').trim();
  const plain=raw.replace(/^[\s\p{Extended_Pictographic}\uFE0F\u200D]+/gu,'').trim();
  if(/^(?:나\s*)?지금\s*(?:나\s*)?(?:이런?\s*)?상황(?:인데|이라면|\?)?$/.test(plain)||/^나 지금 이런 상황인데\?$/.test(plain)) return '지금 이런 상황이라면';
  if(/^(?:10초\s*)?(?:핵심\s*)?결론(?:부터)?$/.test(plain)) return '핵심 결론';
  return raw;
}
function detail(){const t=DATA.find(t=>t.id===route.id&&!t.archived&&String(t.core||'').trim());if(!t)return `<div class="empty"><h2>현재 공개되지 않은 글이에요.</h2><p>통합되었거나 준비 중인 콘텐츠입니다.</p><a class="primary" href="#tips">전체 생활 팁 보기</a></div>`;const siblings=DATA.filter(x=>x.cat===t.cat&&!x.archived&&String(x.core||'').trim()),i=siblings.findIndex(x=>x.id===t.id);const prev=siblings[i-1],next=siblings[i+1];document.title=t.title+' | 눈치패스';return `<div class="breadcrumb"><a href="#home">홈</a> / <a href="#tips?cat=${t.cat}">${cat(t.cat).name}</a></div><div class="article-layout"><article><div class="article-head"><span class="badge">${cat(t.cat).name}</span><span class="article-kind">${esc(t.kind||t.status||'작성 준비 중')}</span><h1 tabindex="-1" id="article-title">${esc(t.title)}</h1><p class="summary">${esc(t.summary)}</p><div class="article-meta"><span>마지막 수정 ${esc(t.sourceReview)}</span><span>약 ${t.minutes}분 읽기</span><div class="article-actions"><button class="small-btn" data-book="${t.id}" aria-pressed="${bookmarks.has(t.id)}">${icon('bookmark')}<span>${bookmarks.has(t.id)?'저장됨':'즐겨찾기'}</span></button><button class="small-btn" data-share="${t.id}">${icon('share')} 공유</button><button class="small-btn" data-copy="${t.id}">주소 복사</button></div></div></div><div class="core${TIP_IMAGES[t.id]?' core-with-image':''}" id="core"><div class="core-copy"><h2>10초 핵심 답변</h2><p>${esc(t.core||'핵심 답변 작성 준비 중입니다.')}</p></div>${TIP_IMAGES[t.id]?`<img class="core-illustration" src="${TIP_IMAGES[t.id]}" alt="${esc(t.title)} 관련 그림" decoding="async">`:''}</div>${t.sections.length?t.sections.map((sec,n)=>`<section class="article-section" id="body-${n}"><h2>${esc(sectionDisplayTitle(sec.title))}</h2>${sec.body}</section>`).join(''):`<section class="article-section" id="situation"><h2>이런 상황에서</h2><p>${esc(t.summary)}</p></section>`}<div class="prev-next">${prev?`<a href="#tip/${prev.id}"><small>← 이전 생활 팁</small>${esc(prev.title)}</a>`:'<div></div>'}${next?`<a href="#tip/${next.id}"><small>다음 생활 팁 →</small>${esc(next.title)}</a>`:'<div></div>'}</div><a class="back-link" href="${esc(lastList)}">← 목록으로 돌아가기</a></article></div><section class="related"><div class="section-head"><h2>함께 읽으면 좋은 생활 팁</h2><a href="#tips?cat=${t.cat}" class="text-link">카테고리 전체 보기 ↗</a></div><div class="cards">${related(t).map(x=>card(x)).join('')}</div></section>`}
function gameLabPage(){return `<section class="game-lab-page"><div class="page-top"><div class="eyebrow">GAME LAB</div><h1>눈치패스 Game Lab</h1><p>상황을 고르고, 나만의 눈치 캐릭터를 찾아보세요.</p></div><iframe id="np-game-frame" class="game-lab-frame" title="눈치패스 게임" scrolling="no" loading="eager" allow="clipboard-write"></iframe></section>`}
async function mountGame(){
  const f=document.getElementById('np-game-frame');
  if(!f)return;
  const payload=document.getElementById('np-game-payload').textContent.trim();
  try{
    if(typeof DecompressionStream!=='function')throw new Error('이 브라우저는 내장 게임 데이터 압축 해제를 지원하지 않습니다. 최신 Chrome, Edge, Firefox 또는 Safari에서 파일을 여세요.');
    const bytes=Uint8Array.from(atob(payload),ch=>ch.charCodeAt(0));
    const stream=new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));
    const html=await new Response(stream).text();
    if(!f.isConnected)return;
    f.srcdoc=html;
  }catch(err){
    if(!f.isConnected)return;
    const message=String(err?.message||'게임을 불러오지 못했습니다.').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;');
    f.srcdoc='<!doctype html><html lang="ko"><meta charset="utf-8"><body style="font-family:system-ui,sans-serif;padding:24px;line-height:1.8"><h2>게임을 실행할 수 없습니다</h2><p>'+message+'</p></body></html>';
  }
}
window.addEventListener('message',e=>{const f=document.getElementById('np-game-frame');if(f&&e.source===f.contentWindow&&Number.isFinite(e.data?.nunchipassGameHeight)){f.style.height=Math.max(550,Math.min(6000,e.data.nunchipassGameHeight+24))+'px'}});
function render(scroll=true){const previousRoute=route;route=parseRoute();if(previousRoute.view&&(['tips','saved','popular','archive'].includes(route.view))&&(previousRoute.view!==route.view||previousRoute.cat!==route.cat)){layer='';subgroup='';sortMode='default';}if(['tips','saved','popular','archive'].includes(route.view))lastList=location.hash||'#tips';document.title='눈치패스 — 생활의 모든 것';const main=document.getElementById('main');if(route.view==='detail'&&DATA.some(t=>t.id===route.id&&!t.archived&&String(t.core||'').trim()))recordView(route.id);else lastCountedRoute='';main.innerHTML=route.view==='game'?gameLabPage():route.view==='detail'?detail():route.view==='top10'?topPage():route.view==='season'?seasonPage():['tips','saved','popular','archive'].includes(route.view)?listPage():route.view==='categories'?`<div class="page-end"><div class="page-top"><div class="eyebrow">Life categories</div><h1>생활정보 분야</h1><p>지금 필요한 주제부터 펼쳐보세요.</p></div>${catCards()}</div>`:home();window.npDecoratePageHeading(route.view);document.querySelectorAll('[data-nav]').forEach(a=>{const on=a.dataset.nav===route.view||(a.dataset.nav==='categories'&&route.view==='tips'&&route.cat!=='all');a.classList.toggle('active',on);if(on)a.setAttribute('aria-current','page');else a.removeAttribute('aria-current')});document.querySelector('.mobile-nav').innerHTML=[['home','home','홈'],['top10/7','grid','TOP 10'],['season','clipboard','시즌'],['categories','grid','카테고리'],['saved','bookmark','즐겨찾기'],['game','grid','Game Lab']].map(([v,ic,label])=>`<a href="#${v}" class="${(route.view===v||v==='top10/7'&&route.view==='top10')?'active':''}" ${(route.view===v||v==='top10/7'&&route.view==='top10')?'aria-current="page"':''}>${icon(ic)}${label}</a>`).join('');if(route.view==='game')mountGame();bindSearch();if(scroll)window.scrollTo(0,0);if(route.view==='home')window.NunchipassIntro?.play({force:true});else window.NunchipassIntro?.skip();}
function updateResults(){document.getElementById('filters').innerHTML=filters();document.getElementById('results').innerHTML=results()}
function bindSearch(){const f=document.getElementById('search-form');if(!f)return;f.onsubmit=e=>{e.preventDefault();const q=document.getElementById('query').value;const view=['saved','popular'].includes(route.view)?route.view:'tips';location.hash=routeURL(view,q,route.cat||'all')};let timer;document.getElementById('query').oninput=e=>{const q=e.target.value;clearTimeout(timer);timer=setTimeout(()=>{if(['tips','saved','popular','archive'].includes(route.view)){route.q=q;history.replaceState(null,'',routeURL(route.view,q,route.cat));lastList=location.hash;updateResults()}else{location.hash=routeURL('tips',q,'all');setTimeout(()=>{const el=document.getElementById('query');el?.focus();/* search input retains its cursor at the end */},0)}},200)}}
function updateBooks(id){const t=DATA.find(x=>x.id===id);if(!t||t.archived||!String(t.core||'').trim())return;bookmarks.has(id)?bookmarks.delete(id):bookmarks.add(id);const persisted=save('life-bookmarks',[...bookmarks]);document.querySelectorAll(`[data-book="${id}"]`).forEach(b=>{const on=bookmarks.has(id);b.setAttribute('aria-pressed',String(on));if(b.classList.contains('bookmark'))b.setAttribute('aria-label',t.title+' 즐겨찾기 '+(on?'해제':'저장'));else b.querySelector('span').textContent=on?'저장됨':'즐겨찾기'});if(route.view==='saved')updateResults();if(persisted)toast(bookmarks.has(id)?'즐겨찾기에 저장했어요.':'즐겨찾기에서 해제했어요.')}
function shareURL(id){return location.href.split('#')[0]+'#tip/'+id}
async function copy(id){const url=shareURL(id);try{await navigator.clipboard.writeText(url);toast(location.protocol==='file:'?'파일 주소를 복사했어요. 다른 기기에서 열려면 HTML 파일도 전달하세요.':'콘텐츠 주소를 복사했어요.')}catch{const area=document.createElement('textarea');area.value=url;area.style.position='fixed';area.style.opacity='0';document.body.append(area);area.select();const ok=document.execCommand('copy');area.remove();if(ok)toast('주소를 복사했어요.');else prompt('이 주소를 복사해 주세요.',url)}}
async function copySiteURL(url){try{await navigator.clipboard.writeText(url);toast('눈치패스 웹사이트 주소를 복사했어요.')}catch{prompt('눈치패스 주소를 복사해 주세요.',url)}}
document.addEventListener('click',async e=>{const b=e.target.closest('[data-book],[data-filter],[data-tag],[data-share],[data-copy],[data-anchor],[data-share-site]');if(!b)return;if(b.hasAttribute('data-share-site')){e.preventDefault();const name='눈치패스 — 학교에서는 알려주지 않았던 생활의 모든 것';const message='어른이 처음인 당신에게.\n학교에서는 알려주지 않았던 생활의 모든 것 — 눈치패스';if(location.protocol==='file:'){const notice=message+'\n\n현재 오프라인 HTML 파일로 실행 중입니다. 친구에게 전달하려면 이 HTML 파일 자체를 공유하세요.';try{await navigator.clipboard.writeText(notice);toast('소개 문구를 복사했어요. 친구에게는 HTML 파일도 함께 전달하세요.')}catch{prompt('아래 소개 문구를 복사하세요. HTML 파일도 함께 전달해야 합니다.',notice)}return}const url=location.href.split('#')[0];if(navigator.share){try{await navigator.share({title:name,text:message,url})}catch(err){if(err.name!=='AbortError')await copySiteURL(url)}return}await copySiteURL(url);return}if(b.dataset.book){e.preventDefault();updateBooks(b.dataset.book)}if(b.dataset.filter)location.hash=routeURL(route.view,route.q,b.dataset.filter);if(b.dataset.tag){const alias={'장례식예절':'장례식','월세계약':'월세 계약','퇴사준비':'퇴사','사회초년생':'월급'};location.hash=routeURL('tips',alias[b.dataset.tag]||b.dataset.tag,'all')}if(b.dataset.anchor){e.preventDefault();document.getElementById(b.dataset.anchor)?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'})}if(b.dataset.copy)await copy(b.dataset.copy);if(b.dataset.share){const t=DATA.find(x=>x.id===b.dataset.share);if(location.protocol==='file:'){const text=t.title+'\n\n'+t.summary+'\n\n핵심 답변\n'+t.core+'\n\n눈치패스 · 전체 글은 HTML 파일을 전달해 확인하세요.';try{await navigator.clipboard.writeText(text);toast('핵심 내용을 복사했어요. 전체 페이지는 HTML 파일을 전달하세요.')}catch{prompt('아래 내용을 복사해 전달하세요.',text)}return}if(navigator.share&&location.protocol!=='file:'){try{await navigator.share({title:t.title,text:t.summary,url:shareURL(t.id)})}catch(err){if(err.name!=='AbortError')await copy(t.id)}}else await copy(t.id)}});
document.addEventListener('change',e=>{if(e.target.id==='layer'||e.target.id==='subgroup'){if(e.target.id==='layer')layer=e.target.value;else subgroup=e.target.value;updateResults()}if(e.target.id==='sort'){sortMode=e.target.value;updateResults()}});window.addEventListener('hashchange',()=>render());render();
</script><dialog id="np-header-search" aria-labelledby="np-search-title"><form id="np-header-search-form" role="search"><div class="np-search-heading"><h2 id="np-search-title">어떤 생활정보가 궁금하세요?</h2><button type="button" id="np-search-close" aria-label="검색창 닫기">×</button></div><div class="np-search-fields"><input id="np-header-query" type="search" name="q" placeholder="궁금한 상황이나 키워드를 입력하세요" aria-label="생활정보 검색어" autocomplete="off" required><button type="submit">검색</button></div></form></dialog>
<script>
(()=>{const dialog=document.getElementById('np-header-search');const input=document.getElementById('np-header-query');const trigger=document.getElementById('search-focus');trigger.setAttribute('aria-haspopup','dialog');trigger.setAttribute('aria-controls',dialog.id);window.npOpenSearch=()=>{if(!dialog.open)dialog.showModal();input.focus()};document.getElementById('np-search-close').onclick=()=>dialog.close();dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close()}});document.getElementById('np-header-search-form').onsubmit=e=>{e.preventDefault();const q=input.value.trim();if(!q){input.focus();return}dialog.close();location.hash='#tips?q='+encodeURIComponent(q)};})();
</script>

<script id="nunchipass-integrated-intro-controller">window.NunchipassIntroAssets=["https://dldblb.github.io/nunchipass-assets/images/asset_142.webp", "https://dldblb.github.io/nunchipass-assets/images/asset_143.webp", "https://dldblb.github.io/nunchipass-assets/images/asset_144.webp", "https://dldblb.github.io/nunchipass-assets/images/asset_145.webp", "https://dldblb.github.io/nunchipass-assets/images/asset_146.webp", "https://dldblb.github.io/nunchipass-assets/images/asset_147.webp"];
/* Load with defer. PNG files are beside this script by default. */
(() => {
  'use strict';
  function prepareAlignment(root, banner, scene, target, state) {
    if (!target || !target.naturalWidth) return null;
    const card = target.closest('.hero-note');
    const portal = document.createElement('div'); portal.className = 'np-intro-match-layer';
    const actor = new Image(); actor.src = target.currentSrc || target.src; actor.alt = '';
    actor.className = 'np-intro-matched-scene'; portal.append(actor); root.append(portal);
    const previousVisibility = target.style.visibility;
    target.style.visibility = 'hidden'; scene.style.visibility = 'hidden';
    let metrics;
    const measure = () => {
      const b = banner.getBoundingClientRect(), r = target.getBoundingClientRect();
      const scale = Math.min(b.width / 2172, b.height / 724);
      const bounds = [1650, 270, 2125, 660];
      const content = [104, 181, 1205, 1079];
      const factor = Math.min((bounds[2]-bounds[0])*scale/(content[2]-content[0]), (bounds[3]-bounds[1])*scale/(content[3]-content[1]));
      const start = {
        x:b.x+bounds[0]*scale+((bounds[2]-bounds[0])*scale-(content[2]-content[0])*factor)/2-content[0]*factor,
        y:b.y+bounds[1]*scale+((bounds[3]-bounds[1])*scale-(content[3]-content[1])*factor)/2-content[1]*factor,
        w:target.naturalWidth*factor, h:target.naturalHeight*factor
      };
      const targetFactor = Math.min(r.width/target.naturalWidth, r.height/target.naturalHeight);
      const end = {x:r.x+(r.width-target.naturalWidth*targetFactor)/2, y:r.y+(r.height-target.naturalHeight*targetFactor)/2, w:target.naturalWidth*targetFactor, h:target.naturalHeight*targetFactor};
      const c = card?.getBoundingClientRect() || r;
      metrics = {start, end, clip:{x:c.x,y:c.y,w:c.width,h:c.height}, radius:card ? parseFloat(getComputedStyle(card).borderTopLeftRadius)||0 : 0};
    };
    measure(); window.addEventListener('resize', measure); window.addEventListener('scroll', measure, {passive:true});
    const update = (t) => {
      const raw = Math.max(0, Math.min(1, (t-1920)/480)); const progress = raw*raw*(3-2*raw);
      const m=metrics, lerp=(a,b)=>a+(b-a)*progress;
      actor.style.left=lerp(m.start.x,m.end.x)+'px'; actor.style.top=lerp(m.start.y,m.end.y)+'px';
      actor.style.width=lerp(m.start.w,m.end.w)+'px'; actor.style.height=lerp(m.start.h,m.end.h)+'px';
      const s=getComputedStyle(scene); actor.style.filter=s.filter; actor.style.opacity=s.opacity;
      const top=Math.max(0,m.clip.y)*progress, left=Math.max(0,m.clip.x)*progress;
      const right=Math.max(0,innerWidth-m.clip.x-m.clip.w)*progress;
      const bottom=Math.max(0,innerHeight-m.clip.y-m.clip.h)*progress;
      portal.style.clipPath=`inset(${top}px ${right}px ${bottom}px ${left}px round ${m.radius*progress}px)`;
      portal.dataset.alignment=progress===1?'matched':'moving';
    };
    update(0);
    return {update,cleanup(){window.removeEventListener('resize',measure);window.removeEventListener('scroll',measure);target.style.visibility=previousVisibility;}};
  }

  const script = document.currentScript;
  const base = script?.dataset.assetBase || (script?.src ? new URL('.', script.src).href : './');
  const key = 'nunchipass-intro-v2-bgless-3s-seen';
  let current = null;
  let playedInMemory = false;
  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const seen = () => { try { return sessionStorage.getItem(key) === '1'; } catch { return playedInMemory; } };
  const mark = () => { playedInMemory = true; try { sessionStorage.setItem(key, '1'); } catch {} };
  const load = (src) => new Promise((resolve, reject) => {
    const img = new Image(); img.onload = () => resolve(img); img.onerror = reject; img.src = src;
  });
  async function play({ force = false } = {}) {
    if (!force && !document.querySelector('.np-cover-art img')) { document.documentElement.classList.remove('np-intro-pending'); return; }
    if (current || reduced()) { document.documentElement.classList.remove('np-intro-pending'); return; }
    const previousFocus = document.activeElement;
    const root = document.createElement('div'); root.className = 'np-intro-root';
    root.setAttribute('role', 'dialog'); root.setAttribute('aria-modal', 'true'); root.setAttribute('aria-label', '눈치패스 소개');
    const shade = document.createElement('div'); shade.className = 'np-intro-shade';
    const banner = document.createElement('div'); banner.className = 'np-intro-banner'; banner.tabIndex = -1;
    const skip = document.createElement('button'); skip.className = 'np-intro-skip'; skip.innerHTML = '<svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="m4 5 8 7-8 7M13 5l8 7-8 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>'; skip.setAttribute('aria-label', '인트로 건너뛰기'); skip.title = '인트로 건너뛰기'; skip.type = 'button';
    root.append(shade, banner, skip);
    const state = { root, raf: 0, stopped: false, originals: [], oldOverflow: document.documentElement.style.overflow, oldPadding: document.documentElement.style.paddingRight };
    current = state;
    const media = matchMedia('(prefers-reduced-motion: reduce)');
    const finish = (reason) => {
      if (state.stopped) return;
      state.stopped = true; cancelAnimationFrame(state.raf); state.alignment?.cleanup(); root.remove();
      state.originals.forEach(([el, inert]) => { el.inert = inert; });
      document.documentElement.style.overflow = state.oldOverflow;
      document.documentElement.style.paddingRight = state.oldPadding;
      document.removeEventListener('keydown', keydown, true); media.removeEventListener('change', mediaChanged);
      current = null; if (reason !== 'error') mark();
      if (previousFocus?.isConnected && previousFocus !== document.body) previousFocus.focus({ preventScroll: true });
      document.dispatchEvent(new CustomEvent('nunchipass:intro-end', { detail: { reason } }));
    };
    const keydown = (e) => {
      if (e.key === 'Escape') { e.preventDefault(); finish('skip'); }
      else if (e.key === 'Tab') { e.preventDefault(); skip.focus(); }
    };
    const mediaChanged = () => { if (media.matches) finish('reduced-motion'); };
    skip.addEventListener('click', () => finish('skip'));
    document.addEventListener('keydown', keydown, true); media.addEventListener('change', mediaChanged);
    Array.from(document.body.children).forEach(el => { if (!['SCRIPT','STYLE','LINK'].includes(el.tagName)) { state.originals.push([el, el.inert]); el.inert = true; } });
    const scrollbar = window.innerWidth - document.documentElement.clientWidth;
    if (scrollbar > 0) document.documentElement.style.paddingRight = `${parseFloat(getComputedStyle(document.documentElement).paddingRight) + scrollbar}px`;
    document.documentElement.style.overflow = 'hidden'; document.body.append(root); document.documentElement.classList.remove('np-intro-pending'); skip.focus({ preventScroll: true });
    let images, logoImage;
    try {
      const urls = window.NunchipassIntroAssets || ['background_plate','scene_01','scene_02','scene_03','scene_04','logo_layer'].map(name => new URL(`nunchipass_intro_${name}.png`, new URL(base, location.href)).href);
      const timeout = new Promise((_, reject) => { state.loadTimer = setTimeout(() => reject(new Error('Image load timeout')), 10000); });
      const loaded = await Promise.race([Promise.all(urls.map(load)), timeout]); images = loaded.slice(0, 5); logoImage = loaded[5];
    } catch { finish('error'); return; }
    finally { clearTimeout(state.loadTimer); }
    if (state.stopped) return;
    images.forEach((img, i) => { img.alt = ''; if (i) { img.className = 'np-intro-scene'; img.dataset.scene = i; if (i === 1) img.classList.add('is-active'); } if (i) banner.append(img); });
    if (logoImage) { logoImage.alt = ''; logoImage.className = 'np-intro-logo'; banner.append(logoImage); }
    const subtitleImage = new Image(); subtitleImage.src = window.NP_SUBTITLE_IMAGE; subtitleImage.alt = '어른이 처음인 당신에게'; subtitleImage.className = 'np-intro-subtitle'; banner.append(subtitleImage); try { await subtitleImage.decode(); } catch {} if (state.stopped) return;
    const homeTarget = document.querySelector(script?.dataset.alignTarget || '.np-cover-art img');
    if (homeTarget) {
      try { await homeTarget.decode(); } catch {}
      if (state.stopped) return;
      state.alignment = prepareAlignment(root, banner, images[4], homeTarget, state);
    }
    banner.setAttribute('role', 'img'); banner.setAttribute('aria-label', '고민, 발견, 적용, 성공으로 이어지는 눈치패스');
    const start = performance.now(); let phase = 0;
    root.dataset.phase = '1';
    const step = (now) => {
      if (state.stopped) return;
      const t = now - start;
      state.alignment?.update(t);
      const next = t >= 2400 ? 5 : t >= 1920 ? 4 : Math.min(3, Math.floor(t / 480));
      if (next !== phase) {
        phase = next; root.dataset.phase = String(next + 1);
        if (next < 4) images.slice(1).forEach((img, i) => img.classList.toggle('is-active', i === next));
        if (next >= 4) images.slice(1, 4).forEach(img => img.classList.add('is-faint'));
        if (next === 5) root.classList.add('is-finishing');
      }
      if (t >= 3000) { finish('complete'); return; }
      state.raf = requestAnimationFrame(step);
    };
    document.dispatchEvent(new CustomEvent('nunchipass:intro-start'));
    state.raf = requestAnimationFrame(step);
  }
  window.NunchipassIntro = { play, skip: () => current?.root.querySelector('button').click() };
  const autoOptions = { force: false };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => play(autoOptions), { once: true }); else play(autoOptions);
})();

</script>

<style id="nunchipass-card-readability">
/* Card readability: preserve content, give text and illustration separate space. */
.np-home aside.hero-note{min-height:476px;padding:28px 29px;background:linear-gradient(140deg,#6040e8 0%,#7351f0 60%,#967bfa 100%)}
.np-home aside.hero-note .issue{font-size:11px;line-height:1.5;letter-spacing:1.4px;padding-bottom:15px;border-color:#ffffff55;color:#fff}
.np-home aside.hero-note .big{font-size:68px;line-height:1.06;letter-spacing:-3.5px;margin:20px 0 12px;color:#fff}
.np-home aside.hero-note .hero-count-unit{font-size:19px;letter-spacing:0;margin-left:5px}
.np-home aside.hero-note h2{max-width:none;color:#fff}
.np-home aside.hero-note p{max-width:210px;font-size:14px;line-height:1.75;margin:0;color:#f4f0ff;font-weight:450}
.np-home aside.hero-note .note-bottom{max-width:175px;align-items:flex-start;gap:7px;font-size:12px;line-height:1.6;font-weight:600;margin-top:22px;color:#fff}
.np-home aside.hero-note .note-bottom svg{flex:0 0 17px;width:17px;height:19px;margin-top:0}
.np-home aside.hero-note .np-cover-art{width:60%;max-width:none;height:auto;aspect-ratio:1271/1238;right:-12px;bottom:-24px;z-index:1}
.np-home aside.hero-note .np-cover-art img{width:100%;height:100%;object-fit:contain}
@media(max-width:760px){
 .np-home aside.hero-note{min-height:400px;padding:24px;border-radius:22px}
 .np-home aside.hero-note .issue{font-size:10px;letter-spacing:1.1px;padding-bottom:14px}
 .np-home aside.hero-note .big{font-size:64px;line-height:1.06;margin:18px 0 12px}
 .np-home aside.hero-note .hero-count-unit{font-size:17px}
 .np-home aside.hero-note h2{max-width:none;}
 .np-home aside.hero-note p{font-size:13.5px;line-height:1.75;max-width:170px;color:#f4f0ff}
 .np-home aside.hero-note .note-bottom{max-width:142px;font-size:12px;line-height:1.6;margin-top:20px;gap:6px}
 .np-home aside.hero-note .np-cover-art{width:60%;max-width:none;height:auto;right:-12px;bottom:-24px}
}

.np-home aside.hero-note .np-card-mobile-break{display:none}
@media(max-width:760px){.np-home aside.hero-note .np-card-mobile-break{display:initial}}
</style>

<style id="nunchipass-layout-system">/* Shared layout system. Content, routing, illustration and game logic are unchanged. */
:root{--np-max:1200px;--np-pad:32px;--np-gap:20px;--np-radius-sm:12px;--np-radius:18px;--np-radius-lg:24px;--blue:#6545ec;--soft:#f1edff;--line:#e6e2f0;--bg:#f8f9fd;--muted:#69667a}
body{font-size:15px;line-height:1.75;background:var(--bg);color:var(--ink)}
body.dark{--bg:#14171e;--paper:#1d222d;--ink:#f0f2f8;--muted:#b5b8c7;--blue:#b0a0ff;--soft:#2a2540;--line:#39344a}
.container{width:100%;max-width:var(--np-max);padding-inline:var(--np-pad);margin-inline:auto}
main.container{min-height:calc(100dvh - 270px)}
header{background:var(--paper);border-bottom:1px solid var(--line)}
header .header-inner{display:grid;grid-template-columns:120px minmax(0,1fr) 120px;align-items:center;gap:24px;min-height:80px}
header .np-header-logo{margin:0;padding:0;justify-self:start}
header .np-header-logo img{width:108px;height:70px;object-fit:contain}
header .header-inner>nav[aria-label="주 메뉴"]{position:static!important;inset:auto;transform:none!important;display:flex;justify-content:center;align-items:center;gap:24px!important;width:auto!important;margin:0;min-width:0}
header .header-inner>nav[aria-label="주 메뉴"]>a,header .header-inner>nav[aria-label="주 메뉴"]>.nav-group>a{min-height:44px;font-size:14px;line-height:1.4;font-weight:650;padding:0;white-space:nowrap}
header .tools{justify-self:end;margin:0;display:flex;gap:8px}
.icon-btn{width:44px;height:44px;border-radius:var(--np-radius-sm);border-color:var(--line)}
nav .nav-dropdown{border-radius:14px;padding:8px;border-color:var(--line);box-shadow:0 12px 36px #24194314}
nav .nav-dropdown a{min-height:40px;padding:10px 12px;font-size:13px;line-height:1.4;border-radius:8px}
.eyebrow{font-size:11px;line-height:1.5;letter-spacing:1.4px;font-weight:800}
.page-top{padding:40px 0 28px;margin:0}
.page-top h1{font-size:34px;line-height:1.35;letter-spacing:-1.2px;margin:10px 0 12px}
.page-top p{font-size:15px;line-height:1.75;max-width:760px;color:var(--muted)}
.section-head{gap:20px;margin-bottom:20px;align-items:flex-end}
.section-head h2,.related>h2{font-size:24px;line-height:1.4;letter-spacing:-.8px;margin:0}
.section-head p{font-size:13.5px;line-height:1.7;margin:7px 0 0;color:var(--muted)}
.page-end{padding-bottom:48px}

/* Home: one grid, one vertical rhythm and bounded decorative artwork. */
.np-home .hero{padding:40px 0 32px;border:0}
.np-home .hero-layout{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:40px;align-items:stretch}
.np-home .hero-copy{padding:0;min-width:0;justify-content:center}



.np-home aside.hero-note{border-radius:var(--np-radius-lg);margin:0}
.np-home .np-search-area{width:100%;max-width:none;padding-top:32px;margin-top:12px}
.np-home .np-search-area::before{width:min(100%,420px);max-width:100%;height:200px;right:0;bottom:calc(100% - 24px);transform:none;transform-origin:50% 100%;clip-path:none;border-radius:65% 60% 0 0;background:radial-gradient(ellipse at 70% 75%,#d9ceff 0%,#e9e2ff 62%,#eee9ff 100%);-webkit-mask-image:linear-gradient(to bottom,#000 0%,#000 55%,transparent 100%);mask-image:linear-gradient(to bottom,#000 0%,#000 55%,transparent 100%)}
.np-home .np-search-area>.np-hero-mascot{right:20px;width:128px;height:116px}
.dark .np-home .np-search-area::before{opacity:.22}
.search{min-height:60px;gap:12px;padding:8px 8px 8px 16px;border:1px solid var(--line);border-radius:14px;box-shadow:0 4px 20px #2b205506;background:var(--paper)}
.search input{font-size:15px;line-height:1.5;padding:10px 0}
.search button{min-height:42px;padding:10px 20px;border-radius:10px;font-size:14px}
.tags{gap:8px;margin-top:16px}
.tag{min-height:32px;font-size:12px;line-height:1.5;padding:6px 12px;border-radius:999px;background:var(--soft);color:var(--blue)}
.np-home .daily-feature{padding:16px 0 32px}
.np-home .daily-feature .daily,.np-home .daily-feature .daily.daily-has-illustration{grid-template-columns:180px minmax(0,1fr) 140px 44px!important;gap:24px;padding:24px;min-height:160px;margin:0;border:1px solid #b5a6fb;border-radius:var(--np-radius-lg);box-shadow:0 8px 28px #3f2c8b08}
.np-home .daily-feature .daily:not(.daily-has-illustration){grid-template-columns:180px minmax(0,1fr) 44px!important}
.np-home .daily-feature .daily h2{font-size:21px;line-height:1.4;margin:6px 0}
.np-home .daily-feature .daily h3{font-size:21px!important;line-height:1.5;margin:0 0 8px}
.np-home .daily-feature .daily p{font-size:13px;line-height:1.7}
.np-home .daily-feature .np-today-illustration{width:140px;height:112px}
.np-home .daily-feature .np-today-illustration img{transform:none;width:100%;height:100%;object-fit:contain}
.np-home .daily-feature .daily .icon-btn{width:44px;height:44px;border-radius:12px}
.np-home .situation{padding:0 0 32px}
.np-home .situations{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
.np-home .situation-link{display:flex;flex-direction:column;min-width:0;min-height:0;padding:10px;border-radius:var(--np-radius);border:1px solid var(--line);background:var(--paper);box-shadow:none}
.np-home .np-scene-image{width:100%;aspect-ratio:4/3;min-height:0;border-radius:12px;overflow:hidden}
.np-home .np-scene-image img{object-fit:contain}
.np-home .situation-caption{display:flex;flex-direction:column;gap:6px;padding:12px 8px 8px}
.np-home .situation-link strong{font-size:17px;line-height:1.5;letter-spacing:-.4px}
.np-home .situation-link small{font-size:12.5px;line-height:1.6;color:var(--muted)}
.np-home .home-share{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;align-items:center;min-height:160px;padding:28px;margin:0 0 40px;border:1px solid var(--line);border-radius:var(--np-radius-lg);background:var(--paper);overflow:hidden}
.np-home .home-share-copy{max-width:520px}
.np-home .home-share h2{font-size:22px;line-height:1.5;margin:8px 0}
.np-home .home-share p{font-size:13.5px;line-height:1.7;color:var(--muted)}
.np-home .home-share-button{min-height:46px;border-radius:12px;padding:12px 20px;font-size:14px}
.np-home .np-share-art{right:230px;bottom:-12px;width:250px;height:160px}

/* Shared cards, filters, list pages, ranking and category pages. */
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.card{min-width:0;min-height:240px;padding:24px;border-radius:var(--np-radius);border:1px solid var(--line);box-shadow:none}
.card .top{margin-bottom:16px}
.card h3{font-size:18px;line-height:1.55;letter-spacing:-.45px;margin:0 0 12px}
.card p{font-size:13.5px;line-height:1.75;margin:0 0 20px;color:var(--muted)}
.card .meta{font-size:12px;line-height:1.5;gap:12px}
.badge{font-size:11px;line-height:1.5;padding:5px 9px;border-radius:7px}
.bookmark{min-width:40px;min-height:40px}
.categories{grid-template-columns:repeat(5,minmax(0,1fr));gap:20px}
.category{display:flex;flex-direction:column;min-width:0;min-height:240px;padding:24px 20px;border-radius:var(--np-radius);border-color:var(--line);box-shadow:none}
.category .cat-icon{margin-bottom:20px;border-radius:12px}
.category h3{font-size:17px;line-height:1.5;margin:0 0 8px}
.category p{font-size:13px;line-height:1.75;min-height:0}
.category .cat-bottom{margin-top:auto;padding-top:22px;font-size:12px}
.list-controls{padding:20px;margin-bottom:24px;border-radius:var(--np-radius);border-color:var(--line)}
.filter-row{gap:8px;margin-top:16px}
.filter,.period-tabs a{min-height:38px;padding:8px 14px;border-radius:999px;font-size:12.5px;line-height:1.6}
.period-tabs{gap:8px;margin:0 0 24px}
.results-bar{gap:12px;flex-wrap:wrap;margin-bottom:20px;font-size:13px}
select{min-height:38px;max-width:100%;padding:8px 12px;border-radius:10px;font-size:13px;line-height:1.4}
.empty{padding:56px 24px;border-radius:var(--np-radius);line-height:1.8}
.top-notice{padding:16px 20px;border-radius:14px;line-height:1.75}
.ranking-list{gap:16px}
.rank-item{gap:20px;padding:22px;border-radius:var(--np-radius);border-color:var(--line)}
.rank-content h2{font-size:18px;line-height:1.55;margin:8px 0}
.rank-content p{font-size:13px;line-height:1.7}
.rank-count{font-size:12px;line-height:1.5}
.season-section{padding:24px;margin:12px 0 24px;border-radius:var(--np-radius-lg);box-shadow:none}
.season-section .section-head{margin:0 0 20px;padding-bottom:20px}
.season-section .section-head h2{font-size:22px;line-height:1.5}
.season-label{font-size:17px;line-height:1.5;margin:32px 0 12px}
.season-title-row{gap:12px}
.season-period{font-size:12px;border-radius:999px;padding:6px 12px}

/* Article readability uses the same typography and panel treatment. */
.breadcrumb{font-size:12px;line-height:1.7;margin:28px 0 24px}
.article-layout{display:block;width:100%;max-width:820px;margin-inline:auto}
.article-head{padding-bottom:28px;border-color:var(--line)}
.article-head h1{font-size:36px!important;line-height:1.4!important;letter-spacing:-1.2px;margin:16px 0}
.article-head .summary{font-size:17px;line-height:1.85;color:var(--muted)}
.article-meta{font-size:12px;line-height:1.7;gap:12px;margin-top:24px}
.article-actions{gap:8px;flex-wrap:wrap}
.small-btn,.primary{min-height:42px;border-radius:10px;font-size:13px;line-height:1.5}
.core{padding:24px;margin:28px 0;border-radius:var(--np-radius);background:var(--soft)}
.core p{font-size:18px;line-height:1.85}
.article-section{margin:32px 0}
.article-section h2{font-size:22px;line-height:1.5;margin:0 0 16px}
.article-section li{font-size:15px;line-height:1.95;margin-bottom:12px}
.prev-next{gap:20px;padding-top:24px;margin:32px 0}
.prev-next a{padding:20px;border-radius:14px;font-size:14px;line-height:1.7}
.related{padding:24px 0 40px}
.game-lab-page{padding:0 0 48px}
.game-lab-page .page-top{padding:40px 0 28px}
footer{padding:32px 0;border-color:var(--line);background:var(--paper)}
.footer-inner{gap:32px;align-items:flex-start}
footer .np-footer-logo img{width:156px;height:auto}
footer p{font-size:12px;line-height:1.85;margin:5px 0}

@media(min-width:761px) and (max-width:1050px){
 :root{--np-pad:24px;--np-gap:16px}
 header .header-inner{grid-template-columns:96px minmax(0,1fr) 96px;gap:16px;min-height:76px}
 header .np-header-logo img{width:92px;height:62px}
 header .header-inner>nav[aria-label="주 메뉴"]{gap:15px!important}
 header .header-inner>nav[aria-label="주 메뉴"]>a,header .header-inner>nav[aria-label="주 메뉴"]>.nav-group>a{font-size:12px}
 .np-home .hero-layout{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:28px}
 
 .np-home .daily-feature .daily,.np-home .daily-feature .daily.daily-has-illustration{grid-template-columns:145px minmax(0,1fr) 110px 44px!important;gap:16px;padding:20px}
 .np-home .daily-feature .daily:not(.daily-has-illustration){grid-template-columns:145px minmax(0,1fr) 44px!important}
 .np-home .daily-feature .np-today-illustration{width:110px;height:100px}
 .np-home .daily-feature .daily h3{font-size:19px!important}
 .np-home .situations{gap:16px}
 .np-home .situation-link strong{font-size:15px}
 .np-home .np-share-art{display:none}
 .cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
 .categories{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
}
@media(max-width:760px){
 :root{--np-pad:16px;--np-gap:14px}
 body{padding-bottom:calc(82px + env(safe-area-inset-bottom))}
 header .header-inner{grid-template-columns:minmax(0,1fr) auto;gap:16px;min-height:68px}
 header .np-header-logo img{width:88px;height:56px}
 header .header-inner>nav[aria-label="주 메뉴"]{display:none!important}
 header .tools{gap:8px}
 .icon-btn{width:40px;height:40px;border-radius:12px}
 .page-top,.game-lab-page .page-top{padding:28px 0 24px}
