/* Header reference: stacked brand, open navigation and unboxed controls. */
header{background:var(--paper);backdrop-filter:none}
header .header-inner{grid-template-columns:124px minmax(0,1fr) 88px;gap:28px;min-height:132px;padding-top:14px;padding-bottom:14px}
header .np-header-brand{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;width:120px;overflow:visible}
header .np-header-logo img{width:112px;height:77px;object-fit:contain}
header .np-header-subtitle{width:116px;max-width:none;flex:none;margin-top:-9px;display:block}
header .np-header-subtitle img{display:block;width:100%;height:auto}
header .header-inner>nav[aria-label="주 메뉴"]{justify-content:space-evenly;align-items:center;gap:28px!important}
header .header-inner>nav[aria-label="주 메뉴"]>a,header .header-inner>nav[aria-label="주 메뉴"]>.nav-group>a{position:relative;font-size:15px;font-weight:650;color:var(--ink);padding:12px 0;line-height:1.5}
header .header-inner>nav[aria-label="주 메뉴"] a.active{color:var(--blue)}
header .header-inner>nav[aria-label="주 메뉴"]>a.active::after,header .header-inner>nav[aria-label="주 메뉴"]>.nav-group>a.active::after{content:'';position:absolute;left:0;right:0;bottom:3px;height:4px;border-radius:4px;background:#a855f7}
header .tools{gap:8px;align-items:center;justify-content:flex-end}
header .tools .icon-btn{width:38px;height:40px;border:0;background:transparent;border-radius:10px}
header .tools [data-share-site]{display:none}
@media(min-width:761px) and (max-width:1100px){
 header .header-inner{grid-template-columns:116px minmax(0,1fr) 80px;gap:20px}
 header .header-inner>nav[aria-label="주 메뉴"]{gap:20px!important}
 header .header-inner>nav[aria-label="주 메뉴"]>a,header .header-inner>nav[aria-label="주 메뉴"]>.nav-group>a{font-size:14px}
 header .np-header-brand{grid-column:1;grid-row:1;width:116px}
 header .tools{grid-column:3;grid-row:1}
 header .header-inner>nav[aria-label="주 메뉴"]{grid-column:2;grid-row:1}
}
@media(max-width:760px){
 header .header-inner{grid-template-columns:minmax(0,1fr) auto;min-height:108px;gap:14px;padding-top:10px;padding-bottom:10px}
 header .np-header-brand{width:104px;gap:0}
 header .np-header-logo img{width:96px;height:66px}
 header .np-header-subtitle{width:102px;flex:none;margin-top:-8px}
 header .tools{gap:6px}header .tools .icon-btn{width:38px;height:40px}
}

/* Original reference brand and compact header. */
header .header-inner{min-height:100px;padding-top:5px;padding-bottom:5px;grid-template-columns:124px minmax(0,1fr) 88px}
header .np-header-brand{width:120px}
header .np-reference-brand img{width:110px;height:auto;max-height:94px;object-fit:contain}
header .header-inner>nav[aria-label="주 메뉴"]>a,header .header-inner>nav[aria-label="주 메뉴"]>.nav-group>a{font-size:18px;font-weight:650}
#np-header-search{width:min(620px,calc(100vw - 36px));max-width:620px;padding:28px;border:1px solid var(--line);border-radius:20px;background:var(--paper);color:var(--ink);box-shadow:0 24px 80px #10182840}
#np-header-search::backdrop{background:#10182880}
.np-search-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px}
.np-search-heading h2{font-size:21px;line-height:1.5;margin:0}
#np-search-close{border:0;background:transparent;color:var(--muted);font-size:30px;width:38px;height:38px;line-height:1}
.np-search-fields{display:flex;gap:10px}
#np-header-query{min-width:0;flex:1;padding:13px 14px;border:1px solid var(--line);border-radius:12px;background:var(--bg);color:var(--ink);font-size:16px}
.np-search-fields button{border:0;border-radius:12px;padding:12px 22px;background:var(--blue);color:var(--paper);font-weight:700}
@media(min-width:761px) and (max-width:1100px){header .header-inner{grid-template-columns:116px minmax(0,1fr) 80px;gap:18px}header .header-inner>nav[aria-label="주 메뉴"]{gap:20px!important}header .header-inner>nav[aria-label="주 메뉴"]>a,header .header-inner>nav[aria-label="주 메뉴"]>.nav-group>a{font-size:16px}}
@media(max-width:760px){header .header-inner{min-height:88px;padding-top:4px;padding-bottom:4px;grid-template-columns:minmax(0,1fr) auto}header .np-header-brand{width:100px}header .np-reference-brand img{width:92px;height:auto;max-height:80px}#np-header-search{padding:20px}.np-search-heading h2{font-size:18px}.np-search-fields{gap:7px}.np-search-fields button{padding:10px 15px}}
</style>

<script>
document.addEventListener('click',e=>{const home=e.target.closest('a[href="#home"]');if(home&&(!location.hash||location.hash==='#home'))window.NunchipassIntro?.play({force:true});});
</script>
<script id="np-nav-accessibility-fix">
(()=>{for(const group of document.querySelectorAll('header nav .nav-group')){const trigger=group.querySelector(':scope > a[aria-haspopup]');if(!trigger)continue;const sync=()=>trigger.setAttribute('aria-expanded',String(group.matches(':hover')||group.contains(document.activeElement)));group.addEventListener('mouseenter',sync);group.addEventListener('mouseleave',sync);group.addEventListener('focusin',sync);group.addEventListener('focusout',()=>requestAnimationFrame(sync));group.addEventListener('keydown',e=>{if(e.key==='Escape'){trigger.focus();trigger.setAttribute('aria-expanded','false');e.preventDefault();}});}})();
</script>
</body></html>
