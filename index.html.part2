 .np-home .situations{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
 .np-home .situation-link{padding:8px;border-radius:18px}
 .np-home .np-scene-image{aspect-ratio:1.15;border-radius:12px}
 .np-home .situation-caption{padding:10px 4px 6px;gap:5px}
 .np-home .situation-link strong{font-size:14px;line-height:1.5}
 .np-home .situation-link small{font-size:11.5px;line-height:1.6}
 .np-home .home-share{display:block;min-height:0;padding:24px;margin-bottom:32px;border-radius:24px}
 .np-home .home-share h2{font-size:20px;line-height:1.5}
 .np-home .home-share p{font-size:13px;line-height:1.7}
 .np-home .np-share-art{display:none}
