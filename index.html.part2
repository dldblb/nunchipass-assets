 .article-meta{gap:10px;font-size:11.5px}
 .article-actions{margin-left:0;width:100%;margin-top:4px;gap:8px}
 .small-btn{padding:9px 11px;font-size:12px}
 .core{padding:20px;margin:24px 0}
 .core p{font-size:17px;line-height:1.85}
 .article-section{margin:28px 0}
 .article-section h2{font-size:20px}
 .article-section li{font-size:14.5px;line-height:1.95}
