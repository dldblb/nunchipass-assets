 .cards{grid-template-columns:minmax(0,1fr);gap:14px}
 .card{padding:20px;min-height:0;border-radius:18px}
 .card h3{font-size:18px;line-height:1.55}
 .card p{font-size:13.5px;line-height:1.75}
 .card .meta{font-size:11.5px}
 .categories{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
 .category{padding:20px 16px;min-height:220px;border-radius:18px}
 .category .cat-icon{margin-bottom:16px;width:40px;height:40px}
 .category h3{font-size:16px;line-height:1.5}
 .category p{font-size:12px;line-height:1.7}
 .category .cat-bottom{font-size:11px;padding-top:18px}
 .list-controls{padding:16px;margin-bottom:20px}
 .filter,.period-tabs a{font-size:12px;padding:8px 12px;min-height:36px}
 .results-bar{font-size:12px;margin-bottom:18px}
 .rank-item{padding:18px;gap:12px;border-radius:18px}
 .rank-num{font-size:24px;width:28px;flex-shrink:0}
