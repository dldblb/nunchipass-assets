 .page-top p{font-size:14px;line-height:1.75}
 .page-end{padding-bottom:32px}
 .section-head{gap:12px;margin-bottom:18px}
 .section-head h2,.related>h2{font-size:22px}
 .section-head p{font-size:13px}
 .np-home .hero{padding:28px 0 24px}
 .np-home .hero-layout{display:grid;grid-template-columns:minmax(0,1fr);gap:24px}
 .np-home .hero-copy{padding:0}
 
 
 
 .np-home .np-search-area{padding-top:28px;margin-top:12px}
 .np-home .np-search-area::before{height:160px;right:0;bottom:calc(100% - 20px);transform:none;width:100%}
 .np-home .np-search-area>.np-hero-mascot{width:96px;height:96px;right:18px}
 .np-home .mobile-hint{font-size:12px;line-height:1.7;margin-top:10px;color:var(--muted)}
 .search{min-height:56px;gap:8px;padding:7px 7px 7px 12px}
 .search input{font-size:14px}
 .search button{min-height:40px;padding:9px 14px;font-size:13px}
 .tags{gap:6px;margin-top:14px}
 .tag{padding:6px 10px;font-size:11px;min-height:32px}
 .np-home aside.hero-note{margin:0;border-radius:24px}
 .np-home .daily-feature{padding:0 0 28px}
 .np-home .daily-feature .daily,.np-home .daily-feature .daily.daily-has-illustration,.np-home .daily-feature .daily:not(.daily-has-illustration){grid-template-columns:minmax(0,1fr) 44px!important;gap:18px 12px;padding:20px;min-height:0;border-radius:24px}
 .np-home .daily-feature .daily-label{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-column:1/-1;align-items:baseline;gap:5px 8px}
 .np-home .daily-feature .daily-label .eyebrow{grid-column:1/-1;margin:0;font-size:10px}
 .np-home .daily-feature .daily h2{font-size:20px;margin:0}
 .np-home .daily-feature .daily-label p{font-size:10.5px;margin:0}
 .np-home .daily-feature .daily-content{grid-column:1;min-width:0}
 .np-home .daily-feature .daily h3{font-size:18px!important;line-height:1.5;margin:0 0 8px}
 .np-home .daily-feature .daily .icon-btn{grid-column:2;grid-row:2;width:44px;height:44px}
