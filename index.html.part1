<!doctype html>
<html lang="ko"><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob: https://dldblb.github.io https://*.github.io; connect-src 'none'; base-uri 'none'; form-action 'none'"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="학교에서는 알려주지 않았던 생활의 모든 것. 청년을 위한 실전 생활정보."><title>눈치패스 — 생활의 모든 것</title><style>
:root{--bg:#F8F9FA;--paper:#fff;--ink:#202124;--muted:#6B7280;--blue:#3459E6;--soft:#EAF0FF;--line:#E5E7EB;--shadow:0 10px 35px #20212408}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:100px}body{margin:0;background:var(--bg);color:var(--ink);font-family:Pretendard,'Noto Sans KR',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;line-height:1.65;word-break:keep-all}body.dark{--bg:#14171e;--paper:#1d222d;--ink:#f0f2f8;--muted:#a5afc1;--blue:#9aacff;--soft:#26324d;--line:#343b49;--shadow:none}a{color:inherit;text-decoration:none}button,input,select{font:inherit}button,a,input,select{-webkit-tap-highlight-color:transparent}button{cursor:pointer}button:disabled{cursor:default}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--blue);outline-offset:4px}svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round;vertical-align:middle}.container{max-width:1240px;padding:0 30px;margin:auto}header{position:sticky;top:0;z-index:20;background:var(--paper);border-bottom:1px solid var(--line)}.header-inner{display:flex;align-items:center;gap:36px;min-height:82px}.logo{font-weight:850;font-size:25px;letter-spacing:-1.4px;white-space:nowrap}.logo span{color:var(--blue)}nav{display:flex;align-items:center;gap:27px;flex:1}nav a{font-size:14px;color:var(--muted);padding:10px 0}nav a.active{color:var(--blue);font-weight:750}.tools{display:flex;gap:9px}.icon-btn{width:44px;height:44px;display:inline-flex;justify-content:center;align-items:center;background:transparent;border:1px solid var(--line);border-radius:50%;color:var(--ink)}.icon-btn:hover{background:var(--soft);color:var(--blue)}.skip{position:absolute;left:16px;top:-100px}.skip:focus{top:12px;background:var(--paper);padding:10px;z-index:100}main{min-height:65vh}.hero{position:relative;padding:68px 0 56px;border-bottom:1px solid var(--line)}.eyebrow{font-size:11px;font-weight:750;letter-spacing:2.2px;color:var(--blue);text-transform:uppercase;display:flex;align-items:center;gap:12px}.eyebrow:before{content:'';width:26px;height:2px;background:var(--blue)}.hero-layout{display:grid;grid-template-columns:1fr 340px;gap:60px;align-items:center}.hero h1 span{color:var(--blue)}.hero p{font-size:15px;color:var(--muted);margin:0 0 26px;line-height:1.85}.search{display:flex;align-items:center;gap:12px;background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:9px 10px 9px 20px;box-shadow:var(--shadow)}.search:focus-within{border-color:var(--blue)}.search input{width:100%;min-width:0;border:0;background:transparent;color:var(--ink);padding:10px 0;font-size:15px;outline:none}.search button,.primary{background:var(--blue);color:var(--paper);border:0;border-radius:8px;padding:11px 20px;white-space:nowrap;font-weight:650}.dark .primary,.dark .search button{color:#14171e}.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.tag{border:0;background:transparent;color:var(--muted);font-size:12px;padding:4px 3px}.tag:hover{color:var(--blue)}.hero-note{border:1px solid var(--line);background:var(--paper);border-radius:18px;padding:26px;transform:rotate(2deg);box-shadow:var(--shadow)}.hero-note .issue{font-size:11px;letter-spacing:2px;color:var(--muted);display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:18px}.hero-note .big{font-size:70px;line-height:1.3;letter-spacing:-5px;color:var(--blue);font-weight:750;margin:15px 0 0}.hero-note p{font-size:12px;margin:0}.note-bottom{display:flex;gap:8px;align-items:center;margin-top:25px;font-size:11px;color:var(--blue)}.section{padding:38px 0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.section-head h2{font-size:25px;letter-spacing:-1px;margin:0}.section-head p{font-size:13px;color:var(--muted);margin:5px 0 0}.text-link{font-size:13px;color:var(--muted);white-space:nowrap}.text-link:hover{color:var(--blue)}.categories{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.category{border:1px solid var(--line);border-radius:14px;padding:21px 18px;background:var(--paper);transition:transform .15s,border-color .15s}.category:hover{transform:translateY(-3px);border-color:var(--blue)}.cat-icon{height:44px;width:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;background:var(--soft);color:var(--blue)}.category h3{font-size:16px;letter-spacing:-.6px;margin:0 0 9px}.category p{font-size:12px;color:var(--muted);margin:0;line-height:1.7;min-height:61px}.cat-bottom{display:flex;justify-content:space-between;margin-top:24px;font-size:11px;color:var(--muted)}.cat-bottom b{color:var(--ink)}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{position:relative;display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:23px;transition:border-color .15s,transform .15s;min-height:210px}.card:hover{border-color:var(--blue);transform:translateY(-2px)}.card .top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:15px}.badge{font-size:11px;color:var(--blue);background:var(--soft);border-radius:5px;padding:4px 8px;display:inline-block}.bookmark{border:0;background:none;color:var(--muted);padding:6px;min-width:38px;min-height:38px}.bookmark[aria-pressed=true]{color:var(--blue)}.bookmark[aria-pressed=true] svg{fill:var(--soft)}.card h3{font-size:19px;letter-spacing:-.6px;line-height:1.5;margin:0 0 10px}.card h3 a:after{content:'';position:absolute;inset:0}.card .bookmark{z-index:2;position:relative}.card p{font-size:13px;color:var(--muted);margin:0 0 20px;line-height:1.8}.card .meta{font-size:11px;color:var(--muted);margin-top:auto;display:flex;justify-content:space-between;align-items:center}.daily{display:grid;grid-template-columns:240px 1fr auto;align-items:center;gap:34px;background:var(--soft);padding:30px 34px;border-radius:16px;margin-bottom:46px}.daily .eyebrow{margin-bottom:8px}.daily h2{font-size:23px;letter-spacing:-1px;margin:0}.daily h3{font-size:20px;margin:0 0 7px;letter-spacing:-.7px}.daily p{font-size:13px;color:var(--muted);margin:0}.page-top{padding:40px 0 26px}.page-top h1{font-size:36px;letter-spacing:-1.6px;margin:8px 0}.page-top p{color:var(--muted);font-size:14px;margin:0}.list-controls{background:var(--paper);padding:20px;border:1px solid var(--line);border-radius:14px;margin-bottom:25px}.list-controls .search{box-shadow:none;background:var(--bg)}.filter-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.filter{padding:8px 13px;border:1px solid var(--line);background:var(--paper);border-radius:8px;color:var(--muted);font-size:12px}.filter.active{background:var(--blue);border-color:var(--blue);color:var(--paper)}.dark .filter.active{color:#14171e}.results-bar{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;font-size:13px;color:var(--muted)}select{background:var(--paper);border:1px solid var(--line);color:var(--ink);border-radius:7px;padding:7px 10px;font-size:12px}.empty{padding:75px 20px;text-align:center;border:1px dashed var(--line);border-radius:14px;color:var(--muted);grid-column:1/-1}.empty h2{color:var(--ink);font-size:20px}.empty .primary{display:inline-block;margin-top:14px}mark{background:#fff0a1;color:#242424;border-radius:2px}.breadcrumb{color:var(--muted);font-size:12px;margin:28px 0 20px}.breadcrumb a:hover{color:var(--blue)}.article-layout{display:grid;grid-template-columns:minmax(0,820px) 240px;gap:60px}.article-head{border-bottom:1px solid var(--line);padding-bottom:28px}.article-head h1{font-size:37px;line-height:1.4;letter-spacing:-1.7px;margin:16px 0}.article-head .summary{font-size:17px;color:var(--muted);line-height:1.8}.article-meta{display:flex;flex-wrap:wrap;align-items:center;gap:15px;font-size:12px;color:var(--muted);margin-top:24px}.article-actions{display:flex;gap:8px;margin-left:auto}.small-btn{display:inline-flex;gap:7px;align-items:center;background:var(--paper);color:var(--ink);border:1px solid var(--line);padding:8px 12px;border-radius:8px;font-size:12px;min-height:42px}.small-btn svg{width:18px;height:18px}.core{background:var(--soft);border-radius:14px;padding:27px;margin:30px 0}.core h2{font-size:15px;margin:0 0 12px;color:var(--blue)}.core p{margin:0;font-size:18px;line-height:1.85;font-weight:600}.article-section{margin:34px 0}.article-section h2{font-size:21px;letter-spacing:-.6px;margin:0 0 15px}.article-section ul,.article-section ol{padding-left:23px;margin:0}.article-section li{padding-left:5px;margin-bottom:13px;font-size:15px;line-height:1.95}.section-number{color:var(--blue);font-size:12px;margin-right:11px}.source-list{list-style:none;padding:0!important}.source-list a{color:var(--blue);text-decoration:underline;text-underline-offset:4px;overflow-wrap:anywhere;word-break:break-word;font-size:14px}.source-note{font-size:12px;color:var(--muted);margin:16px 0}.notice{border-left:3px solid var(--line);padding:9px 15px;font-size:12px;color:var(--muted);line-height:1.8}.toc{position:sticky;top:112px;border-top:2px solid var(--ink);padding-top:18px;align-self:start}.toc h2{font-size:13px;margin:0 0 13px}.toc a{display:block;font-size:12px;color:var(--muted);padding:7px 0}.toc a:hover{color:var(--blue)}.toc .side-note{margin-top:24px;padding-top:16px;border-top:1px solid var(--line);font-size:12px;color:var(--muted)}.prev-next{display:grid;grid-template-columns:1fr 1fr;gap:16px;padding-top:28px;border-top:1px solid var(--line);margin:35px 0}.prev-next a{background:var(--paper);padding:18px;border:1px solid var(--line);border-radius:10px;font-size:14px}.prev-next small{display:block;color:var(--muted);font-size:11px;margin-bottom:7px}.related{padding:24px 0 45px}.back-link{display:inline-block;margin-bottom:22px;font-size:14px;color:var(--blue)}footer{border-top:1px solid var(--line);padding:32px 0;color:var(--muted);font-size:12px}.footer-inner{display:flex;justify-content:space-between;gap:30px}footer .logo{font-size:20px;color:var(--ink);margin-bottom:8px}footer p{margin:5px 0}.footer-right{text-align:right}#toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%);padding:12px 20px;border-radius:10px;background:var(--ink);color:var(--paper);z-index:100;font-size:13px;box-shadow:var(--shadow);max-width:90vw;display:none}.mobile-nav{display:none}.source-icon{font-size:11px;color:var(--muted)}.loading{padding:80px;text-align:center}.menu-btn{display:none}.article-kind{display:inline-block;color:var(--muted);font-size:11px;margin-left:9px}.page-end{padding-bottom:50px}.count{font-size:12px;color:var(--muted);margin-left:8px}
@media(max-width:1050px){.header-inner{gap:25px}nav{gap:16px}.hero-layout{grid-template-columns:1fr 280px;gap:30px}.categories{grid-template-columns:repeat(3,1fr)}.category p{min-height:0}.article-layout{grid-template-columns:minmax(0,1fr) 190px;gap:30px}.daily{grid-template-columns:180px 1fr auto;gap:20px}}@media(max-width:760px){.container{padding:0 20px}.header-inner{min-height:66px;justify-content:space-between}.logo{font-size:23px}nav{display:none}.tools{gap:7px}.icon-btn{width:40px;height:40px}.hero{padding:38px 0 32px}.hero-layout{display:block}.hero p{font-size:13px}.hero-note{display:none}.eyebrow{font-size:10px;letter-spacing:1.5px}.search{padding-left:13px;gap:7px}.search input{font-size:13px}.search button{padding:10px 14px;font-size:12px}.categories{grid-template-columns:repeat(2,1fr);gap:10px}.category{padding:17px}.category:last-child{grid-column:1/-1}.category p{font-size:12px}.cat-icon{margin-bottom:13px}.category h3{font-size:15px}.cat-bottom{margin-top:14px}.section{padding:27px 0}.section-head h2{font-size:22px}.section-head p{font-size:12px}.cards{grid-template-columns:1fr;gap:12px}.card{min-height:0;padding:20px}.card h3{font-size:18px}.card .top{margin-bottom:9px}.card p{margin-bottom:17px}.daily{display:block;padding:23px;margin-bottom:30px}.daily h2{font-size:19px}.daily h3{margin-top:20px;font-size:18px}.daily .icon-btn{margin-top:17px}.page-top{padding-top:27px}.page-top h1{font-size:29px}.list-controls{padding:13px}.filter-row{gap:6px}.filter{padding:7px 9px;font-size:11px}.article-layout{display:block}.toc{display:none}.article-head h1{font-size:28px;letter-spacing:-1px}.article-head .summary{font-size:15px}.article-meta{gap:9px}.article-actions{margin-left:0;width:100%;margin-top:7px}.core{padding:21px}.core p{font-size:16px}.article-section li{font-size:14px}.article-section h2{font-size:19px}.prev-next{gap:10px}.prev-next a{padding:13px;font-size:12px}.footer-inner{display:block}.footer-right{text-align:left;margin-top:20px}footer{padding-bottom:98px}.mobile-nav{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:30;background:var(--paper);border-top:1px solid var(--line);padding:8px 12px calc(8px + env(safe-area-inset-bottom));justify-content:space-around}.mobile-nav a{font-size:10px;color:var(--muted);display:flex;flex-direction:column;align-items:center;gap:3px;min-width:50px}.mobile-nav a.active{color:var(--blue)}#toast{bottom:85px}.section-head{gap:10px}.section-head .text-link{font-size:11px}.tag{font-size:11px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}

/* 눈치패스 2.0 — mobile-first visual system */
:root{--bg:#F7F8FC;--paper:#FFFFFF;--ink:#182238;--muted:#69758B;--blue:#5B48E8;--soft:#F0EDFF;--line:#E7E9F3;--shadow:0 14px 40px rgba(31,35,75,.055)}
body.dark{--bg:#101320;--paper:#1B2030;--ink:#F2F4FF;--muted:#A7B0C7;--blue:#B3A5FF;--soft:#302B4A;--line:#383F54;--shadow:none}
body{font-family: 'Pretendard Variable',Pretendard,'Noto Sans KR',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;letter-spacing:-.025em}
.container{max-width:1120px;padding-inline:28px}header{background:color-mix(in srgb,var(--paper) 95%,transparent);backdrop-filter:blur(16px)}.header-inner{min-height:74px}.logo{font-size:25px;letter-spacing:-1.8px}.logo span{color:#FF847A}nav a.active{color:var(--blue)}.icon-btn{border-radius:14px}.icon-btn:hover{background:var(--soft)}
.hero{border:0;padding:61px 0 40px}.hero-layout{grid-template-columns:minmax(0,1fr) 300px;gap:45px}.hero h1 span{color:var(--blue)}.eyebrow{letter-spacing:1.3px;font-size:11px}.eyebrow:before{height:5px;width:5px;border-radius:50%}.hero p{font-size:15px}.hero-note{transform:none;border:0;background:linear-gradient(140deg,#6D55EE,#9785FA);color:#fff;box-shadow:0 20px 40px #5744c72e;min-height:296px}.hero-note .issue,.hero-note p,.hero-note .note-bottom{color:#EDE8FF;border-color:#ffffff55}.hero-note .big{color:#fff;font-size:80px}.hero-note h2{color:#fff}.hero-note .note-bottom{margin-top:24px}.search{border-radius:19px;box-shadow:0 8px 28px #3027690b;padding:8px 8px 8px 18px}.search button,.primary{border-radius:12px;padding:12px 22px;background:#5B48E8;color:#fff!important}.tag{padding:6px 11px;border-radius:20px;background:var(--soft);color:var(--blue);font-weight:650;font-size:12px}.section{padding:27px 0}.section-head h2{font-size:25px}.section-head p{font-size:13px}.categories{gap:13px}.category{border-radius:22px;padding:22px 18px 17px;box-shadow:0 3px 14px #1d234005}.cat-icon{border-radius:15px;width:50px;height:50px;margin-bottom:18px}.category h3{font-size:16px}.cat-bottom{border-top:1px solid var(--line);padding-top:12px;margin-top:18px}.cards{gap:14px}.card{border-radius:20px;padding:23px;min-height:198px}.card h3{font-size:18px}.badge{border-radius:8px;padding:5px 9px}.daily{border-radius:24px;background:linear-gradient(115deg,var(--soft),var(--paper));border:1px solid var(--line)}.page-top h1{font-size:34px}.list-controls{border-radius:20px;padding:18px}.filter-row{gap:9px}.filter{border-radius:100px;padding:9px 16px;font-size:13px;min-height:40px}.filter.active{color:#fff;background:#5B48E8;border-color:#5B48E8}.article-head h1{font-size:36px}.core{border-radius:20px}.small-btn{border-radius:11px}.prev-next a{border-radius:15px}.breadcrumb{margin-top:25px}.mobile-nav{box-shadow:0 -8px 25px #13153609}
/* Situation shortcuts */
.situation{padding:7px 0 28px}.situation-head{margin-bottom:15px}.situations{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.situation-link{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:18px 15px;display:flex;align-items:center;gap:11px;min-height:83px;transition:transform .15s,border-color .15s}.situation-link:hover{transform:translateY(-2px);border-color:var(--blue)}.situation-emoji{font-size:27px;line-height:1;flex-shrink:0}.situation-link strong{display:block;font-size:14px;line-height:1.45}.situation-link small{display:block;font-size:11px;color:var(--muted);margin-top:4px}.brand-mark{display:inline-flex;align-items:center;justify-content:center;width:31px;height:31px;margin-right:7px;border-radius:11px;background:#5B48E8;color:white;font-size:16px;vertical-align:2px;font-weight:850;letter-spacing:-.08em}.mobile-hint{display:none}
@media(max-width:1050px){.situations{grid-template-columns:repeat(2,1fr)}}
@media(max-width:760px){html{scroll-padding-top:82px}body{padding-bottom:env(safe-area-inset-bottom)}.container{padding-inline:18px}.header-inner{min-height:62px}.logo{font-size:22px}.brand-mark{width:29px;height:29px}.tools .icon-btn{width:39px;height:39px;border:0;background:var(--bg)}.hero{padding:31px 0 20px}.hero p{font-size:13px;line-height:1.75;margin-bottom:20px}.hero-note{display:none}.eyebrow{letter-spacing:.9px}.search{border-radius:17px;gap:9px;padding:7px 7px 7px 14px}.search svg{width:20px;height:20px;flex-shrink:0;color:var(--blue)}.search input{font-size:14px;padding:10px 0}.search button{font-size:12px;padding:12px 13px;border-radius:11px}.tags{margin-top:11px;gap:6px}.tag{font-size:11px;padding:6px 9px}.mobile-hint{display:block;color:var(--muted);font-size:11px;margin-top:11px}.section{padding:23px 0}.section-head{align-items:start}.section-head h2{font-size:21px;letter-spacing:-.9px}.section-head p{font-size:12px}.situation{padding:9px 0 16px}.situations{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.situation-link{padding:13px 10px;min-height:76px;gap:8px;border-radius:17px}.situation-emoji{font-size:22px}.situation-link strong{font-size:12px}.situation-link small{font-size:10px}.categories{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.category{padding:16px 13px;border-radius:18px;min-height:159px}.category:last-child{grid-column:auto}.cat-icon{width:40px;height:40px;border-radius:13px;margin-bottom:12px}.cat-icon svg{width:21px}.category h3{font-size:14px;line-height:1.35}.category p{display:none}.cat-bottom{padding-top:11px;margin-top:13px;font-size:10px;gap:4px}.cat-bottom span:last-child{font-size:0}.cat-bottom span:last-child:after{content:'→';font-size:18px;color:var(--blue)}.card{border-radius:18px;padding:17px 18px;min-height:0}.card h3{font-size:17px;margin-bottom:6px}.card p{font-size:12px;line-height:1.7;margin-bottom:10px}.card .meta{font-size:10px}.badge{font-size:10px}.daily{padding:21px;border-radius:20px}.page-top{padding:22px 0}.page-top h1{font-size:28px}.list-controls{border-radius:17px;padding:12px;margin-bottom:17px}.filter-row{flex-wrap:nowrap;overflow-x:auto;margin-inline:-12px;padding:3px 12px 8px;scrollbar-width:none}.filter-row::-webkit-scrollbar{display:none}.filter{flex:0 0 auto;min-height:40px;padding:8px 14px;font-size:12px}.results-bar{gap:5px}.article-head h1{font-size:27px}.article-head .summary{font-size:14px}.core{padding:20px;border-radius:17px}.core p{font-size:16px}.article-section{margin:28px 0}.article-section li{font-size:14px}.article-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.article-actions .small-btn{justify-content:center;font-size:11px;padding:7px 5px;min-width:0}.article-actions .small-btn svg{width:16px}.mobile-nav{padding:8px 12px calc(8px + env(safe-area-inset-bottom));border-radius:18px 18px 0 0;box-shadow:0 -5px 25px #12132d12}.mobile-nav a{font-size:10px;min-height:46px;min-width:62px;gap:4px;justify-content:center;border-radius:12px}.mobile-nav a svg{width:23px;height:23px}.mobile-nav a.active{color:#5B48E8;font-weight:800;background:var(--soft)}footer{padding-bottom:100px}.prev-next{grid-template-columns:1fr 1fr;gap:8px}.prev-next a{overflow-wrap:anywhere}}
@media(max-width:350px){.situations{grid-template-columns:1fr 1fr}.situation-link{gap:5px;padding:11px 8px}.situation-emoji{font-size:19px}.situation-link strong{font-size:11px}.category h3{font-size:13px}}
.article-section p{line-height:1.9;overflow-wrap:anywhere}.article-section code{background:var(--soft);padding:2px 5px;border-radius:4px}.article-section h3{font-size:17px;margin:21px 0 10px}.article-section blockquote{margin:15px 0;padding:9px 16px;border-left:3px solid var(--blue);background:var(--soft);border-radius:0 10px 10px 0}.article-section blockquote p{margin:5px 0}.article-section a{color:var(--blue);text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}.article-section ol,.article-section ul{margin:10px 0 16px;padding-left:23px}.article-section li p{margin:0}.article-section hr{border:0;border-top:1px solid var(--line);margin:24px 0}.article-section table{border-collapse:collapse;width:100%;display:block;overflow-x:auto}.article-section th,.article-section td{border:1px solid var(--line);padding:9px;min-width:90px;text-align:left}.article-section strong{font-weight:750}
/* Navigation dropdowns and new pages */
nav .nav-group{position:relative;display:flex;align-items:center}nav .nav-group>a{display:inline-flex;align-items:center;gap:5px}nav .nav-chevron{display:inline-flex;align-items:center;justify-content:center;width:13px;height:13px;line-height:1;flex:none;margin:0}nav .nav-chevron svg{display:block;width:12px;height:12px}nav .nav-dropdown{position:absolute;z-index:40;top:100%;left:-16px;min-width:210px;padding:10px;background:var(--paper);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);display:none;flex-direction:column;gap:0}nav .nav-dropdown a{padding:9px 12px;border-radius:8px;white-space:nowrap;color:var(--ink)}nav .nav-dropdown a:hover,nav .nav-dropdown a:focus-visible{background:var(--soft);color:var(--blue)}nav .nav-group:hover .nav-dropdown,nav .nav-group:has(:focus-visible) .nav-dropdown{display:flex}
.daily-feature{padding:36px 0 10px}.daily-feature .daily{background:var(--soft);border:2px solid var(--blue);box-shadow:0 16px 30px #3459e618;padding:35px;border-radius:22px}.daily-feature .daily h2{font-size:27px}.daily-feature .daily h3{font-size:23px}.daily-feature .daily .icon-btn{background:var(--blue);color:#fff;border-color:var(--blue)}
.period-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0 26px}.period-tabs a{padding:10px 18px;border-radius:99px;border:1px solid var(--line);background:var(--paper);font-weight:700;font-size:14px}.period-tabs a.active{background:var(--blue);color:#fff;border-color:var(--blue)}.ranking-list{display:grid;gap:10px}.rank-item{background:var(--paper);border:1px solid var(--line);border-radius:14px;display:flex;align-items:center;gap:22px;padding:20px}.rank-item:hover{border-color:var(--blue)}.rank-num{font-size:26px;color:var(--blue);width:32px;text-align:center}.rank-content{flex:1;min-width:0}.rank-content h2{font-size:18px;margin:7px 0 4px}.rank-content p{color:var(--muted);font-size:13px;margin:0}.rank-count{font-size:12px;color:var(--muted);white-space:nowrap}.season-label{font-size:19px;font-weight:800;padding:16px 0;border-bottom:1px solid var(--line);margin:15px 0}.season-other{margin-top:35px}.season-section{margin:25px 0 35px}.season-empty{color:var(--muted);padding:15px 0}
@media(max-width:760px){.daily-feature .daily{padding:24px}.daily-feature .daily h2{font-size:23px}.daily-feature .daily h3{font-size:20px}.rank-item{gap:11px;padding:15px}.rank-content h2{font-size:15px}.rank-content p{display:none}.rank-num{font-size:21px;width:25px}.rank-count{font-size:11px}.period-tabs a{font-size:12px;padding:9px 12px}}

/* Distinct seasonal grouping and period chips */
.season-label{display:flex;align-items:center;gap:10px;font-size:17px;font-weight:800;border:0;padding:0 0 14px;margin:30px 0 8px;color:var(--ink)}
.season-label::before{content:"";width:5px;height:19px;border-radius:5px;background:var(--blue)}
.season-section{padding:22px;margin:12px 0 28px;background:var(--paper);border:1px solid var(--line);border-radius:20px;box-shadow:0 3px 14px rgba(12,34,69,.025)}
.season-section .section-head{margin:0 0 18px; padding:0 0 15px;border-bottom:1px solid var(--line)}
.season-section .section-head h2{font-size:22px;margin:0 0 8px}
.season-section .section-head p{font-size:13px;margin:0;color:var(--muted)}
.season-period{display:inline-flex;align-items:center;padding:6px 11px;background:var(--soft);color:var(--blue);border-radius:999px;font-size:12px;font-weight:700;white-space:nowrap}
.season-title-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:6px}
.season-title-row h2{margin:0!important}
.season-section .cards{margin:0}
.rank-count.example{font-weight:700;color:var(--muted);background:var(--soft);padding:5px 9px;border-radius:8px}
.top-notice{border:1px solid var(--line);border-radius:12px;background:var(--paper);padding:14px 16px;font-size:13px;color:var(--muted);margin-bottom:18px;line-height:1.7}
@media(max-width:760px){.season-section{padding:15px}.season-section .section-head h2{font-size:19px}.season-title-row{gap:8px}.season-period{font-size:11px}}

/* Home visual refinement, 2026-10-14: existing structure and behavior unchanged */
@media(min-width:761px){
  .header-inner{min-height:66px;gap:29px}
  header nav{gap:24px}
  header nav>a,header nav .nav-group>a{font-size:14px;font-weight:650;min-height:42px;display:inline-flex;align-items:center;line-height:1.3;white-space:nowrap}
  header nav .nav-group>a{gap:7px}
  .hero{padding-top:44px;padding-bottom:27px}
  
  .hero-layout{align-items:center}
  .hero p{font-size:15px;line-height:1.75;margin-bottom:18px}
  .hero-note{min-height:255px;padding:24px}
  .daily-feature{padding-top:22px;padding-bottom:8px}
  .daily-feature .daily{grid-template-columns:minmax(170px,210px) minmax(0,1fr) 48px;gap:24px;padding:27px 31px;min-height:148px;margin-bottom:25px}
  .daily-feature .daily h2{font-size:23px}
  .daily-feature .daily h3{font-size:23px;line-height:1.45}
  .situation{padding-top:18px;padding-bottom:35px}
  .situations{gap:13px}
  .situation-link{min-height:94px;padding:19px 17px}
  .situation-link strong{font-size:14px}
  .situation-link small{font-size:12px}
}
header nav .nav-group>a{display:inline-flex;align-items:center;gap:6px}
header nav .nav-chevron{height:16px;width:15px;display:inline-flex;vertical-align:middle;justify-content:center;align-items:center;transform:none}
header nav .nav-chevron svg{width:13px;height:13px;display:block;flex:none}
header nav a:focus-visible,.situation-link:focus-visible,.daily-feature a:focus-visible{outline:3px solid #8d7aff;outline-offset:3px}
header nav>a:hover,header nav .nav-group>a:hover{color:var(--blue)}
.hero-layout>div:first-child{min-width:0}
.hero .eyebrow{font-size:11px;letter-spacing:1.3px;font-weight:800}

.hero p{color:var(--muted)}
.hero-note .big{line-height:1.15}
.search{min-height:57px;border:1px solid var(--line);border-radius:18px;background:var(--paper);box-shadow:0 8px 26px rgba(42,36,89,.045)}
.search:focus-within{border-color:#7564f2;box-shadow:0 0 0 4px rgba(99,78,238,.1)}
.search input{font-size:15px;min-width:0}
.search button{min-height:41px;font-weight:750}
.tags{gap:8px}.tag{font-size:12px;padding:7px 10px}
.daily-feature .daily{background:linear-gradient(115deg,var(--soft),var(--paper));border:1px solid #8b77ff;box-shadow:0 12px 32px rgba(80,60,186,.085);transition:box-shadow .18s ease}
.daily-feature .daily:hover{box-shadow:0 16px 38px rgba(80,60,186,.12)}
.daily-feature .daily h3{letter-spacing:-.55px;font-weight:800;overflow-wrap:anywhere}
.daily-feature .daily p{line-height:1.6;color:var(--muted)}
.daily-feature .daily .icon-btn{height:44px;width:44px;display:inline-flex;align-items:center;justify-content:center;border-radius:13px}
.situation-head h2{font-weight:850}.situation-head p{font-size:13px;line-height:1.7}
.situation-link{box-shadow:0 2px 6px rgba(30,26,65,.02);transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}
.situation-link:hover{transform:translateY(-3px);box-shadow:0 12px 24px rgba(48,36,100,.08)}
.situation-emoji{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;background:var(--soft);border-radius:12px;font-size:23px}
footer p{font-size:12px;line-height:1.8}
@media(min-width:761px) and (max-width:1000px){header nav{gap:13px}.header-inner{gap:18px}.daily-feature .daily{grid-template-columns:160px minmax(0,1fr) 44px;gap:14px}.situation-link{padding:15px 12px}}
@media(max-width:760px){
  .hero{padding:29px 0 18px}
  
  .hero p{font-size:14px;line-height:1.7;margin-bottom:16px}
  .search{min-height:54px}
  .search input{font-size:14px}
  .daily-feature{padding-top:17px}
  .daily-feature .daily{padding:22px 19px;border-radius:19px}
  .daily-feature .daily h3{font-size:19px;line-height:1.45}
  .situation{padding-top:14px}
  .situation-link{min-height:88px;padding:13px 11px}
  .situation-emoji{width:32px;height:32px;border-radius:9px;font-size:20px}
  .situation-link strong{font-size:12px}
  .situation-link small{font-size:11px}
}
@media(prefers-reduced-motion:reduce){.daily-feature .daily,.situation-link{transition:none}}


/* 홈: 서비스 자체 공유(기존 섹션 뒤에 배치) */
.home-share{margin:30px 0 54px;padding:24px 30px;border:1px solid var(--line);background:var(--paper);border-radius:20px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.home-share .eyebrow{font-size:10px;color:var(--blue);margin-bottom:8px}
.home-share h2{font-size:20px;line-height:1.4;margin:0 0 7px;color:var(--ink)}
.home-share p{font-size:13px;line-height:1.7;color:var(--muted);margin:0}
.home-share-button{border:0;background:var(--blue);color:white;border-radius:12px;padding:13px 18px;display:inline-flex;align-items:center;justify-content:center;gap:9px;font:inherit;font-size:14px;font-weight:700;cursor:pointer;white-space:nowrap;transition:transform .15s ease,opacity .15s ease}
.home-share-button:hover{transform:translateY(-2px);opacity:.92}
.home-share-button:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
.home-share-button svg{width:17px;height:17px}
@media(max-width:640px){.home-share{flex-direction:column;align-items:stretch;padding:22px 20px;gap:16px}.home-share h2{font-size:18px}.home-share-button{width:100%}}

.core-with-image{display:grid;grid-template-columns:minmax(0,1fr) 240px;align-items:center;gap:24px}.core-copy{min-width:0}.core-illustration{display:block;width:100%;height:auto;max-height:260px;object-fit:contain;border-radius:12px}@media(max-width:760px){.core-with-image{grid-template-columns:minmax(0,1fr) 145px;gap:14px}.core-illustration{max-height:190px}}@media(max-width:420px){.core-with-image{grid-template-columns:minmax(0,1fr) 110px;gap:10px}.core-with-image{padding:20px 16px}.core-with-image p{font-size:15px}}
</style><style>
/* 2026-10-14: desktop navigation centered within header without changing page structure */
@media (min-width: 1051px) {
  .header-inner { position: relative; }
  .header-inner > nav[aria-label="주 메뉴"] {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
  }
  .header-inner > .tools { margin-left: auto; }
}
</style>
<style id="np-article-template-unification">
/* 129개 상세페이지 공통 양식: 제목 / 요약 / 핵심 답변 / 본문 / 관련글 */
.article-layout .article-head h1{line-height:1.34;overflow-wrap:anywhere}
.article-layout .article-head .summary{line-height:1.75;overflow-wrap:anywhere}
.article-layout .core{border-radius:18px}
.article-layout .core h2{letter-spacing:-.035em;line-height:1.35}
.article-layout .article-section{margin-block:32px}
.article-layout .article-section h2{font-size:20px;line-height:1.45;letter-spacing:-.035em;margin-bottom:14px;overflow-wrap:anywhere}
.article-layout .article-section p,.article-layout .article-section li{line-height:1.85;overflow-wrap:anywhere}
.article-layout .article-section p+p{margin-top:13px}
.article-layout .article-section ul,.article-layout .article-section ol{padding-left:24px}
.article-layout .toc a{overflow-wrap:anywhere;line-height:1.5}
@media(max-width:720px){.article-layout .article-section h2{font-size:19px}.article-layout .article-section{margin-block:27px}}
</style>

<style id="np-layout-balance-20261014">
/* 레이아웃 균형: 콘텐츠 및 기능 유지, 중앙축/비율만 조정 */
@media (min-width:1051px) {
  .container { max-width:1200px; padding-inline:32px; margin-inline:auto; }
  .hero-layout { grid-template-columns:minmax(0, 1.85fr) minmax(0, 1fr); gap:40px; align-items:center; }
  .hero-layout > * {min-width:0;}
  .article-layout {grid-template-columns:minmax(0, 760px) 210px; gap:38px; max-width:1008px; margin-inline:auto;}
}
@media (min-width:761px) and (max-width:1050px) {
  .container {max-width:100%; padding-inline:28px; margin-inline:auto;}
  .hero-layout {grid-template-columns:minmax(0, 1.8fr) minmax(240px, 1fr);gap:30px;}
  .article-layout {grid-template-columns:minmax(0, 1fr) 190px;gap:30px;max-width:940px;margin-inline:auto;}
}
@media (max-width:760px) {
  .container {margin-inline:auto;}
  .hero-layout {display:block;}
  .article-layout {display:block;max-width:100%;}
}
/* 글은 왼쪽 정렬, 카드와 섹션은 공통 컨테이너 기준선 사용 */
.hero-layout, .daily-feature, .situation, .article-layout {margin-inline:auto;}
.article-layout > * {min-width:0;}
</style>
<style id="np-remove-article-toc">
/* 상세 글의 우측 목차 제거 후 본문을 중앙에 배치 */
@media (min-width:761px) {
  .article-layout {display:block; width:100%; max-width:800px; margin-inline:auto;}
}
@media (max-width:760px) { .article-layout {display:block; max-width:100%;} }
</style>
<style id="np-game-lab-style">
.game-lab-page{padding:34px 0 50px}.game-lab-page .page-top{padding:0 0 20px}.game-lab-frame{display:block;border:0;width:100%;height:800px;background:transparent;overflow:hidden}.game-lab-intro{font-size:13px;color:var(--muted);margin-bottom:18px}
@media(min-width:1051px){.header-inner>nav[aria-label="주 메뉴"]{gap:17px}header nav .nav-group>a,header nav>a{font-size:13px}}
@media(min-width:761px) and (max-width:1050px){header nav{gap:10px}.header-inner{gap:14px}header nav .nav-group>a,header nav>a{font-size:12px}}
@media(max-width:760px){.game-lab-page{padding:22px 0 30px}.game-lab-page .page-top h1{font-size:28px}.mobile-nav a{min-width:0;flex:1}.mobile-nav{gap:2px;padding-inline:5px}.mobile-nav a{font-size:9px}}
</style><style id="np-nav-spacing-fix">
/* Keep an identical edge-to-edge gap between the six top-level menu items. */
@media (min-width:761px) {
  .header-inner > nav[aria-label="주 메뉴"] { display:flex; align-items:center; column-gap:24px; row-gap:0; }
  .header-inner > nav[aria-label="주 메뉴"] > a,
  .header-inner > nav[aria-label="주 메뉴"] > .nav-group { flex:0 0 auto; margin:0; }
  .header-inner > nav[aria-label="주 메뉴"] > a,
  .header-inner > nav[aria-label="주 메뉴"] > .nav-group > a { box-sizing:border-box; min-height:42px; padding:0; display:inline-flex; align-items:center; vertical-align:middle; }
  .header-inner > nav[aria-label="주 메뉴"] > .nav-group > a { gap:6px; }
  .header-inner > nav[aria-label="주 메뉴"] .nav-chevron { width:14px; height:16px; margin:0; flex:0 0 14px; }
  .header-inner > nav[aria-label="주 메뉴"] .nav-chevron svg { width:13px; height:13px; }
}
@media (min-width:761px) and (max-width:1050px) {
  .header-inner > nav[aria-label="주 메뉴"] { column-gap:16px; }
}
</style>
<style id="np-home-image-ready-2026">
/* Image-ready home redesign — screenshot-based visual layout. Assets are optional. */
:root{--blue:#6245f4;--soft:#f0edff;--ink:#111e40;--bg:#f7f8ff;--line:#e1e5f5}
body{background:radial-gradient(ellipse at 48% 16%,#eeeefe 0%,transparent 44%),var(--bg)}
body.dark{--blue:#ad9aff;--soft:#302b4a;--ink:#f2f4ff;--bg:#101320;--line:#383f54;background:var(--bg)}
.np-home .hero{padding:35px 0 16px}.np-home .hero-layout{grid-template-columns:minmax(0,1.44fr) minmax(0,1fr);gap:20px;align-items:stretch}
.np-home .hero-copy{padding:6px 0 4px;position:relative;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}
.np-home .eyebrow{color:var(--blue);font-weight:850;letter-spacing:1.5px}.np-home .hero h1{color:var(--ink)}
.np-home .hero h1 span{color:var(--blue)}.np-home .hero p.hero-tagline{color:var(--blue);}
.np-home .hero p.hero-description{color:var(--muted);}
.np-search-area{position:relative;width:100%;max-width:650px;padding-top:36px}.np-home .search{position:relative;z-index:3;min-height:66px;border-radius:18px;padding:8px 9px 8px 20px;box-shadow:0 12px 35px #38297712}
.np-home .search button{padding:13px 25px}.np-home .tags{margin-top:14px;gap:8px}.np-home .tag{background:#edeafe;padding:7px 13px;color:#6045ec}.dark .np-home .tag{background:var(--soft);color:var(--blue)}
.np-home .hero-note{position:relative;isolation:isolate;overflow:hidden;min-height:395px;border-radius:26px;background:linear-gradient(134deg,#6441ef 0%,#8265f9 65%,#9e88ff 100%);padding:27px 29px;box-shadow:0 15px 40px #6450cc20}
.np-home .hero-note .issue{padding-bottom:13px;font-size:12px;font-weight:750;letter-spacing:1.5px;color:#fff;border-color:#ffffff66}
.np-home .hero-note .big{font-size:clamp(62px,6vw,86px);font-weight:850;letter-spacing:-5px;margin:14px 0 0;line-height:1.08;color:white}.np-home .hero-count-unit{font-size:19px;letter-spacing:0;margin-left:4px}
.np-home .hero-note h2{color:#fff;}.np-home .hero-note p{color:#ddd5ff;font-size:12px;line-height:1.8}.np-home .hero-note .note-bottom{font-size:11px;color:#fff;margin-top:25px;position:relative;z-index:2}
.np-art{pointer-events:none}.np-art img{display:block;width:100%;height:100%;object-fit:contain}.np-art img[hidden]{display:none}.np-cover-art{position:absolute;right:-18px;bottom:-8px;width:62%;height:62%;z-index:1}
.np-cover-art:has(img[hidden]){background:radial-gradient(circle at 80% 80%,#ccbdfd66,transparent 70%);border-radius:50%}.np-hero-mascot{position:absolute;right:32px;bottom:calc(100% - 2px);width:120px;height:105px;z-index:2;display:flex;align-items:flex-end;justify-content:center}
.np-home .daily-feature{padding:24px 0 7px}.np-home .daily-feature .daily{display:grid;grid-template-columns:210px minmax(0,1fr) 205px 48px;gap:20px;align-items:center;margin:0;min-height:137px;padding:20px 25px;border:1.5px solid #765aff;background:linear-gradient(115deg,#f8f7ff,#fff);box-shadow:0 10px 26px #5140ae0b;border-radius:21px;overflow:hidden}
.np-home .daily h2{font-size:22px!important;color:var(--ink)}.np-home .daily h3{font-size:21px!important;line-height:1.4;margin:0 0 6px;color:var(--ink)}.np-home .daily p{color:var(--muted)}.np-home .daily .eyebrow{font-size:11px;margin-bottom:11px}
.np-daily-art{height:100%;min-height:95px;align-self:end}.np-home .daily .icon-btn{border-radius:13px;width:48px;height:48px}
.np-home .situation{padding:26px 0 4px}.np-home .situation-head{margin-bottom:15px}.np-home .situation-head h2{font-size:27px;letter-spacing:-1.2px}.np-home .situations{grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.np-home .situation-link{display:block;min-height:0;padding:10px 10px 16px;border:1px solid var(--line);background:var(--paper);border-radius:18px;box-shadow:0 3px 15px #27336507;overflow:hidden}
.np-scene-image{position:relative;width:100%;aspect-ratio:1.36;border-radius:12px;overflow:hidden;background:linear-gradient(135deg,#f9e7ed,#f6eee8);display:flex;align-items:center;justify-content:center}
.np-scene-funeral{background:linear-gradient(130deg,#efebe8,#dcd3dc)}.np-scene-housing{background:linear-gradient(130deg,#faf1df,#e8f1dc)}.np-scene-resign{background:linear-gradient(130deg,#e3f0fc,#f7ecde)}
.np-scene-image img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;z-index:2}.np-scene-image img[hidden]{display:none}
.np-image-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;color:#7c7392;font-size:12px;letter-spacing:0}.np-placeholder-symbol{font-size:40px;opacity:.45;line-height:1.4}
.np-scene-image:has(img:not([hidden])) .np-image-placeholder{display:none}
.np-home .situation-caption{display:block;padding:12px 7px 0}.np-home .situation-link strong{font-size:17px;letter-spacing:-.7px;line-height:1.4;color:var(--ink)}.np-home .situation-link small{font-size:13px;margin-top:5px;color:var(--muted)}
.np-home .home-share{position:relative;min-height:123px;margin:18px 0 24px;padding:20px 26px;overflow:hidden;border-radius:18px}.np-home .home-share-copy{z-index:1}.np-home .home-share h2{font-size:22px;margin-bottom:4px}.np-home .home-share-button{z-index:2;padding:14px 22px;background:#6042ed}.np-share-art{position:absolute;bottom:-12px;right:230px;width:225px;height:128px}
@media(min-width:1051px){.container{max-width:1210px}.np-home .hero-layout{grid-template-columns:minmax(0,1.43fr) minmax(0,1fr)} }
@media(min-width:761px) and (max-width:1050px){.np-home .hero-note{min-height:350px}.np-home .daily-feature .daily{grid-template-columns:160px 1fr 90px 45px;gap:12px}.np-home .daily h3{font-size:18px!important}.np-home .situation-link strong{font-size:14px}.np-home .situation-link small{font-size:11px}.np-share-art{display:none}}
@media(max-width:760px){.np-home .hero{padding:27px 0 13px}.np-home .hero-layout{display:block}.np-home .hero-note{display:block;min-height:240px;margin-top:23px;padding:21px;border-radius:20px}.np-home .hero-note .big{font-size:64px}.np-home .hero-note .note-bottom{margin-top:13px}.np-cover-art{width:45%;height:55%}.np-home .search{min-height:56px}.np-hero-mascot{width:70px;height:70px;right:20px;bottom:calc(100% - 2px)}.np-home .daily-feature{padding:14px 0 4px}.np-home .daily-feature .daily{grid-template-columns:minmax(0,1fr) 44px;gap:12px;padding:20px;min-height:145px}.np-home .daily-label,.np-home .daily-content{grid-column:1}.np-home .daily .icon-btn{grid-column:2;grid-row:1 / 3;align-self:center}.np-home .daily h2{font-size:19px!important}.np-home .daily h3{font-size:17px!important}.np-daily-art{display:none}.np-home .situation{padding-top:24px}.np-home .situations{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.np-home .situation-head h2{font-size:23px}.np-home .situation-link{padding:7px 7px 12px;border-radius:15px}.np-scene-image{aspect-ratio:1.1}.np-home .situation-caption{padding:10px 5px 0}.np-home .situation-link strong{font-size:13px}.np-home .situation-link small{font-size:11px}.np-home .home-share{margin:20px 0 26px;padding:20px}.np-home .home-share h2{font-size:18px}.np-share-art{display:none}}
</style><style id="np-svg-inline-slots">
/* SVG는 외부 파일 링크 대신, 위의 SVG_SLOT 구간 내부에 <svg>...</svg>로 직접 삽입합니다. */
.np-art > svg,.np-scene-image > svg{display:block;width:100%;height:100%;max-width:100%;max-height:100%;overflow:visible}
.np-art > .np-svg-placeholder,.np-scene-image > .np-svg-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;text-align:center;padding:12px;font-size:11px;font-weight:650;letter-spacing:0;color:var(--muted);opacity:.65}
.np-cover-art > .np-svg-placeholder{color:#fff;opacity:.8}
.np-scene-image > .np-scene-svg-placeholder{color:#786e97;font-size:12px}
/* SVG 삽입 시 원본 viewBox/비율을 보존합니다. path나 색상 필터는 적용하지 않습니다. */
.np-art > svg,.np-scene-image > svg{object-fit:contain}
 .np-home .daily-feature .daily{grid-template-columns:minmax(155px,210px) minmax(0,1fr) 48px!important;} @media(max-width:760px){.np-home .daily-feature .daily{display:block!important}} </style><style id="np-mobile-layout-repair-20261014">
/* 모바일 레이아웃 충돌만 보정. 데스크톱 스타일 및 삽화 SVG 경로 변경 없음 */
.np-home, .np-home section, .np-home .hero-layout, .np-home .hero-copy, .np-home .daily-feature, .np-home .situation {min-width:0;}
.np-art>svg,.np-scene-image>svg{display:block;max-width:100%;max-height:100%;width:100%;height:100%;flex:none;overflow:hidden;}
.np-scene-image>svg{position:absolute;inset:0;}
.np-home .hero-note .issue,.np-home .hero-note h2,.np-home .hero-note p,.np-home .hero-note .big{position:relative;z-index:2}
@media(max-width:760px){
 html,body{max-width:100%;overflow-x:clip}
 .container{width:100%;min-width:0;padding-inline:16px}
 .np-home{width:100%;min-width:0}
 .np-home .hero{padding:26px 0 12px}
 .np-home .hero-layout{display:flex;flex-direction:column;gap:0;min-width:0}
 .np-home .hero-copy{display:block;width:100%;padding:0;min-width:0}
 .np-home .hero h1{overflow-wrap:keep-all}
 .np-home .hero p.hero-tagline,.np-home .hero p.hero-description{max-width:100%;overflow-wrap:anywhere}
 .np-search-area{width:100%;max-width:100%;margin-top:16px;padding-top:28px;isolation:isolate}
 .np-hero-mascot{right:10px;bottom:calc(100% - 2px);width:clamp(60px,18vw,82px);height:clamp(60px,18vw,82px);z-index:2;display:flex;align-items:flex-end;justify-content:center}
 .np-home .search{width:100%;max-width:100%;min-width:0;min-height:55px;display:flex;gap:7px;padding:7px 7px 7px 12px;position:relative;z-index:3}
 .np-home .search input{min-width:0;width:0;flex:1 1 auto;font-size:13px}
 .np-home .search button{flex:none;font-size:12px;padding:10px 13px}
 .np-home .tags{width:100%;gap:5px}
 .np-home .tag{font-size:11px;padding:6px 9px}
 .np-home .hero-note{width:100%;max-width:100%;min-height:247px;margin:22px 0 0;padding:19px;overflow:hidden;transform:none}
 .np-home .hero-note .issue{font-size:10px;letter-spacing:1px}
 .np-home .hero-note .big{font-size:clamp(54px,16vw,66px);line-height:1.13}
 .np-home .hero-note h2{max-width:65%}
 .np-home .hero-note p{max-width:63%;font-size:11px}
 .np-home .hero-note .note-bottom{font-size:10px;margin-top:12px;max-width:60%}
 .np-cover-art{right:-8px;bottom:-3px;width:48%;height:61%;z-index:1}
 /* 마지막 SVG 슬롯 정의의 display:block!important를 명확히 덮어씀 */
 .np-home .daily-feature{padding:16px 0 4px}
 .np-home .daily-feature .daily{display:grid!important;grid-template-columns:minmax(0,1fr) 42px!important;grid-template-rows:auto auto;align-items:center;gap:8px 10px;padding:17px 15px;min-height:0;border-radius:17px}
 .np-home .daily-label{grid-column:1;grid-row:1;min-width:0}
 .np-home .daily-content{grid-column:1;grid-row:2;min-width:0}
 .np-home .daily .icon-btn{grid-column:2;grid-row:1 / 3;align-self:center;width:42px;height:42px;margin:0}
 .np-home .daily .eyebrow{font-size:9px;margin-bottom:5px}
 .np-home .daily h2{font-size:17px!important}
 .np-home .daily h3{font-size:15px!important;line-height:1.45;overflow-wrap:anywhere}
 .np-home .daily p{font-size:11px;line-height:1.5}
 .np-daily-art{display:none!important}
 .np-home .situations{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
 .np-home .situation-link{display:block;min-width:0;width:100%;padding:7px 7px 12px}
 .np-scene-image{display:block;width:100%;aspect-ratio:1.15;min-height:0;overflow:hidden}
 .np-home .situation-caption{padding:9px 3px 0;min-width:0}
 .np-home .situation-link strong{display:block;font-size:13px;line-height:1.38;overflow-wrap:anywhere}
 .np-home .situation-link small{display:block;font-size:10px;line-height:1.4;overflow-wrap:anywhere}
 .np-home .home-share{min-width:0;width:100%;flex-direction:column;align-items:stretch;gap:12px}
 .np-home .home-share-button{max-width:100%;width:100%;white-space:normal}
 .np-share-art{display:none}
}
@media(max-width:360px){
 .container{padding-inline:12px}
 
 
 .np-home .hero-note p{font-size:10px}
 .np-home .situation-link strong{font-size:12px}
 .np-home .daily-feature .daily{padding:15px 12px}
}
